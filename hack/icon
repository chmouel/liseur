#!/usr/bin/env python3
"""Render the launcher artwork to a PNG for F-Droid and the README.

F-Droid wants a plain 512x512 image. The launcher icon is an adaptive one:
a flat background colour with a raster foreground drawn on top, so this
composites the two rather than cropping a screenshot of a launcher.

A launcher shows the central 72dp of the 108dp viewport, which leaves the
mark surrounded by margin the store tile does not need; at the size a list
row gives it, that margin is most of what you see. So the mark is cropped
to its own bounds and scaled to fill the tile instead.

Needs Pillow.

Usage: hack/icon [OUTPUT]   (default fastlane/metadata/android/en-US/images/icon.png)
"""

from __future__ import annotations

import sys
import xml.etree.ElementTree as ET
from pathlib import Path

from PIL import Image

ANDROID = "http://schemas.android.com/apk/res/android"
ROOT = Path(__file__).resolve().parent.parent
RES = ROOT / "app/src/main/res"
BACKGROUND = RES / "drawable/ic_launcher_background.xml"
FOREGROUND = RES / "drawable-xxxhdpi/ic_launcher_foreground.webp"
VALUES = RES / "values/colors.xml"

SIZE = 512
# Breathing room around the mark, as a fraction of the output edge.
MARGIN = 0.03


def palette() -> dict[str, str]:
    return {c.get("name", ""): (c.text or "").strip() for c in ET.parse(VALUES).getroot()}


def rgb(colour: str) -> tuple[int, int, int]:
    colour = colour.lstrip("#")
    if len(colour) == 8:  # AARRGGBB
        colour = colour[2:]
    return tuple(int(colour[i:i + 2], 16) for i in (0, 2, 4))


def field() -> tuple[int, int, int]:
    """The flat colour the background vector paints."""
    root = ET.parse(BACKGROUND).getroot()
    for path in root.iter("path"):
        colour = path.get(f"{{{ANDROID}}}fillColor")
        if not colour:
            continue
        if colour.startswith("@color/"):
            colour = palette().get(colour[len("@color/"):], "#000000")
        return rgb(colour)
    raise SystemExit(f"error: no filled path in {BACKGROUND.relative_to(ROOT)}")


def main() -> int:
    output = Path(sys.argv[1]) if len(sys.argv) > 1 else (
        ROOT / "fastlane/metadata/android/en-US/images/icon.png"
    )
    for source in (BACKGROUND, FOREGROUND, VALUES):
        if not source.exists():
            print(f"error: missing {source}", file=sys.stderr)
            return 1

    art = Image.open(FOREGROUND).convert("RGBA")
    bounds = art.getbbox()
    if bounds is None:
        print(f"error: {FOREGROUND.relative_to(ROOT)} is empty", file=sys.stderr)
        return 1
    art = art.crop(bounds)

    inner = SIZE - 2 * round(SIZE * MARGIN)
    scale = min(inner / art.width, inner / art.height)
    art = art.resize((round(art.width * scale), round(art.height * scale)), Image.LANCZOS)

    # The store wants no alpha, so the mark goes onto its own field rather
    # than onto whatever the client happens to draw behind it.
    icon = Image.new("RGB", (SIZE, SIZE), field())
    icon.paste(art, ((SIZE - art.width) // 2, (SIZE - art.height) // 2), art)
    output.parent.mkdir(parents=True, exist_ok=True)
    icon.save(output)

    print(f"wrote {output.relative_to(ROOT) if output.is_relative_to(ROOT) else output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
