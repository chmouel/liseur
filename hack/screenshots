#!/usr/bin/env bash
#
# Capture the screenshots used by the README and by F-Droid.
#
#   hack/screenshots --setup      # build a demo shelf first, then capture
#   hack/screenshots              # capture from a device already set up
#   hack/screenshots --setup-only # build the shelf and stop, to check it
#   hack/screenshots --empty      # capture the empty library, and nothing else
#   hack/screenshots -s SERIAL    # pick a device when several are attached
#   hack/screenshots --class tablet   # file the captures as a tablet set
#   hack/screenshots --no-dictionary  # skip the definition card
#
# The definition card is the one picture that needs the device to reach a
# site: the run turns the lookup on, asks en.wiktionary.org about a word
# off the page, and fails if nothing comes back. --no-dictionary is the
# way to say that was expected, on a machine with no route out.
#
# Which set is written is decided by how wide the device is, so a run
# against a tablet cannot quietly overwrite the phone screenshots the
# README embeds. --class overrides the guess.
#
# The screens are found by what they say — a button's label, a book's
# title — rather than by where they happened to sit when this was
# written. A moved control is then a control the script waits for and
# fails on, instead of a tap into empty space and a screenshot of the
# wrong thing.
#
# --setup builds the shelf from scratch: it downloads a handful of
# Standard Ebooks editions (public domain, cover art included, which is
# what makes them publishable), pushes them to the device, grants the
# folder through the real picker, and leaves the first book part-read
# with a highlight, a note and a bookmark on it. Everything the notebook
# and the reader screens need is then really there.
#
# --empty is its own mode because it wants the opposite of everything
# the rest of this script builds: a library with nothing on it. It wipes
# the app's storage, so it cannot be a step in the tour -- it would take
# the demo shelf with it. Run it on its own, and run --setup afterwards
# to get the shelf back.
#
# Nothing here writes to a calibre-web server. Sign out of one before
# running if your server holds books you would not publish a picture of.

set -euo pipefail

readonly APP_ID="com.chmouel.liseur"
readonly MAIN_ACTIVITY="$APP_ID/.MainActivity"
readonly DEVICE_BOOKS="/sdcard/Books"

# shellcheck source=hack/lib/demo-books.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/demo-books.sh"

# The word held down to raise the selection popup, and the one searched
# for in-book. Both are Moby Dick's, which is the book that opens first.
readonly HIGHLIGHT_NOTE="The line that gives the book its weather."
readonly SEARCH_TERM="whale"

# The chapter the reader screenshots are taken in, as the contents sheet
# spells it. Moby Dick's again, and its first.
readonly FIRST_CHAPTER="I: Loomings"

# The Settings switch that lets Define ask a dictionary. It is off until
# someone turns it on, deliberately, so a run that wants a picture of a
# definition has to turn it on and put it back.
readonly DICTIONARY_SWITCH="Look up definitions online"

# A row only the Advanced sheet has, which is how the script tells it
# from the short sheet it opens out of.
readonly ADVANCED_MARKER="Use separate settings for this book"

setup=0
setup_only=0
empty_only=0
want_dictionary=1
serial=""
shot_class=""
while [[ $# -gt 0 ]]; do
    case $1 in
        --setup) setup=1 ;;
        --setup-only)
            setup=1
            setup_only=1
            ;;
        --empty) empty_only=1 ;;
        -s | --serial)
            serial=${2:-}
            shift
            ;;
        --class)
            shot_class=${2:-}
            shift
            ;;
        --no-dictionary) want_dictionary=0 ;;
        -h | --help)
            # Everything down to the first line that is not a comment, so
            # the help never falls behind the header it prints.
            awk 'NR > 2 && /^#/ { sub(/^# ?/, ""); print; next } NR > 2 { exit }' "$0"
            exit 0
            ;;
        *)
            printf 'error: unknown argument %s\n' "$1" >&2
            exit 1
            ;;
    esac
    shift
done

command -v adb >/dev/null || die "adb is not installed"
command -v python3 >/dev/null || die "python3 is not installed"

if [[ -z "$serial" ]]; then
    mapfile -t devices < <(adb devices | awk 'NR > 1 && $2 == "device" { print $1 }')
    [[ ${#devices[@]} -eq 1 ]] ||
        die "expected exactly one attached device, got ${#devices[@]}; pass --serial"
    serial=${devices[0]}
fi

adb() { command adb -s "$serial" "$@"; }

adb shell pm path "$APP_ID" >/dev/null 2>&1 ||
    die "$APP_ID is not installed on $serial"

read -r width height < <(
    adb shell wm size | sed -nE 's/.*: ([0-9]+)x([0-9]+)/\1 \2/p' | tail -n 1
)
[[ -n "$width" && -n "$height" ]] || die "could not read the display size"

work=$(mktemp -d)
cleanup() {
    adb shell am broadcast -a com.android.systemui.demo -e command exit >/dev/null 2>&1 || true
    adb shell cmd uimode night no >/dev/null 2>&1 || true
    adb shell rm -f /sdcard/liseur-ui.xml >/dev/null 2>&1 || true
    rm -rf "$work"
}
trap cleanup EXIT

# ---------------------------------------------------------------- the UI

# Settings now lives in the shelf's overflow menu rather than on the bar,
# so it has to be opened before it can be found.
open_settings() {
    on_screen "Settings" || tap_on "More" exact
    tap_on "Settings"
    wait_for "Theme" >/dev/null || sleep 2
}

# Whether a settings switch is on. The row carries the checked state but
# no text of its own, so this finds the label and then the switch row
# wrapped around it: prints "on" or "off", or nothing if there is no such
# row on screen.
#
#   switch_state <label>
switch_state() {
    python3 - "$work/ui.xml" "$1" <<'PY'
import re, sys, xml.etree.ElementTree as ET

path, needle = sys.argv[1], sys.argv[2].lower()

def box(node):
    m = re.match(r"\[(\d+),(\d+)\]\[(\d+),(\d+)\]", node.get("bounds", ""))
    return tuple(int(g) for g in m.groups()) if m else None

try:
    nodes = list(ET.parse(path).getroot().iter("node"))
except ET.ParseError:
    sys.exit(1)

label = next(
    (n for n in nodes if (n.get("text") or "").strip().lower().startswith(needle)),
    None,
)
if label is None or (lb := box(label)) is None:
    sys.exit(1)

# The smallest checkable box that contains the label is its own row and
# not, say, a scroll container that happens to enclose several.
rows = [
    (b, n) for n in nodes if n.get("checkable") == "true"
    if (b := box(n)) and b[0] <= lb[0] and b[1] <= lb[1] and b[2] >= lb[2] and b[3] >= lb[3]
]
if not rows:
    sys.exit(1)
_, row = min(rows, key=lambda r: (r[0][2] - r[0][0]) * (r[0][3] - r[0][1]))
print("on" if row.get("checked") == "true" else "off")
PY
}

# Put a settings switch in a known position. Tapping blind would toggle
# whatever the last run left behind, which is how a screenshot set ends
# up half in one palette and half in another.
#
#   set_switch <label> <on|off>
set_switch() {
    local label=$1 want=$2 now
    wait_for "$label" 15 >/dev/null || die "no \"$label\" switch on screen"
    now=$(switch_state "$label") || die "could not read the \"$label\" switch"
    if [[ $now == "$want" ]]; then
        note "$label already $want"
        return 0
    fi
    tap_on "$label"
    sleep 2
    dump_ui
    [[ $(switch_state "$label") == "$want" ]] ||
        die "could not turn \"$label\" $want"
    note "$label turned $want"
}

# Bring something below the fold into view, on any screen that scrolls
# with a swipe. `wait_for` only ever looks at what is already on screen,
# so a switch further down a long form is a switch it never finds.
#
#   scroll_to <needle> [exact|prefix|contains]
scroll_to() {
    local needle=$1 mode=${2:-prefix} i
    for i in 1 2 3 4 5 6 7 8; do
        dump_ui && find_node "$needle" "$mode" >/dev/null && return 0
        adb shell input swipe "$(x 0.5)" "$(y 0.75)" "$(x 0.5)" "$(y 0.35)" 400
        sleep 1
    done
    dump_ui && find_node "$needle" "$mode" >/dev/null
}

# Tap something on the shelf, scrolling down to it if it is below the
# fold. Only the shelf scrolls this way; a swipe in the reader turns a
# page instead.
tap_on_shelf() {
    local needle=$1 mode=${2:-prefix} i at
    for i in 1 2 3 4 5 6; do
        if dump_ui && at=$(find_node "$needle" "$mode"); then
            # shellcheck disable=SC2086
            adb shell input tap $at
            sleep 2
            return 0
        fi
        adb shell input swipe "$(x 0.5)" "$(y 0.75)" "$(x 0.5)" "$(y 0.3)" 400
        sleep 2
    done
    die "never found \"$needle\" on the shelf"
}

# Back to the top of the shelf, so a capture starts where the last one did.
shelf_to_top() {
    local i
    for i in 1 2 3 4 5 6; do
        adb shell input swipe "$(x 0.5)" "$(y 0.3)" "$(x 0.5)" "$(y 0.8)" 300
        sleep 1
    done
    sleep 1
}

# The selection popup is a Compose popup, in a window uiautomator does not
# report, so nothing in it can be found by what it says. Its highlight
# colours give it away in a screenshot instead, and the rest of the row
# sits a fixed distance from the first of them.
#
# Every colour has to be listed, in the order HighlightTint declares
# them. The offsets below are measured from the first chip, so a colour
# this file has not heard of puts Note and Define a chip further right
# than it aims -- which is what a fifth and a sixth did: Define landed on
# Note, opened the note editor, and the run photographed the old
# definition card for several releases running.
readonly TINTS="FFD54F,9CCC65,64B5F6,F06292,B39DDB,FFB74D"
# 30dp of chip and 6dp of gap: what the colours are spaced at, which is
# how a row of chips is told from marks that happen to line up.
readonly POPUP_CHIP_PITCH_DP=36
readonly POPUP_NOTE_DP=227
readonly POPUP_DEFINE_DP=291

density=$(adb shell wm density | sed -nE 's/.*density: ([0-9]+).*/\1/p' | tail -n 1)
[[ -n "$density" ]] || density=420
dp() { printf '%.0f' "$(awk "BEGIN { print $1 * $density / 160 }")"; }

# ------------------------------------------------------- where they land
#
# Two sets, because a tablet capture is not a phone capture: fastlane
# and F-Droid publish phoneScreenshots and tenInchScreenshots as separate
# listings, and the README embeds the phone set by name. Writing both to
# one directory means a run against a tablet silently replaces the images
# the README shows.
#
# The phone set is the full tour. The tablet set is three pictures of
# what a phone cannot show -- two columns, the control that chooses them,
# and a shelf with room on it. A tablet listing does not need its own
# picture of the settings screen.
#
# The class is guessed from the width so that no flag is needed to stay
# out of trouble; --class overrides it, for a device whose shape does not
# match how its pictures should be filed.

width_dp=$(awk "BEGIN { printf \"%d\", $width * 160 / $density }")

if [[ -z "$shot_class" ]]; then
    if [[ $width_dp -ge 600 ]]; then
        shot_class="tablet"
    else
        shot_class="phone"
    fi
    note "device is ${width_dp}dp wide: capturing the $shot_class set"
else
    case $shot_class in
        phone | tablet) ;;
        *) die "unknown --class \"$shot_class\": want phone or tablet" ;;
    esac
    note "capturing the $shot_class set (device is ${width_dp}dp wide)"
fi
readonly shot_class

if [[ $shot_class == phone ]]; then
    readonly OUT_DIR="docs/screenshots"
    # F-Droid's directory names are fixed, so the tablet set goes in the
    # one it reads even though nothing here is measured in inches.
    readonly FASTLANE_DIR="fastlane/metadata/android/en-US/images/phoneScreenshots"
else
    readonly OUT_DIR="docs/screenshots/tablet"
    readonly FASTLANE_DIR="fastlane/metadata/android/en-US/images/tenInchScreenshots"
fi

# A screencap decoded to pixels without a library: an emulator host may
# have no Pillow on it, and asking for one would put a pip install
# between a checkout and a screenshot. Reads the file named by the first
# argument and leaves out, width, height, channels and stride behind for
# whatever is appended to it.
readonly PNG_DECODER=$(
    cat <<'PYEOF'
import struct, sys, zlib

path = sys.argv[1]
data = open(path, "rb").read()
if data[:8] != b"\x89PNG\r\n\x1a\n":
    sys.exit(1)

pos, idat, width, height, colour = 8, b"", 0, 0, 0
while pos < len(data):
    length, typ = struct.unpack(">I4s", data[pos:pos + 8])
    chunk = data[pos + 8:pos + 8 + length]
    if typ == b"IHDR":
        width, height, _, colour = struct.unpack(">IIBB", chunk[:10])
    elif typ == b"IDAT":
        idat += chunk
    pos += 12 + length

raw = zlib.decompress(idat)
channels = {0: 1, 2: 3, 3: 1, 4: 2, 6: 4}[colour]
stride = width * channels
out, prev, p = bytearray(), bytearray(stride), 0
for _ in range(height):
    f = raw[p]
    p += 1
    line = bytearray(raw[p:p + stride])
    p += stride
    if f == 1:
        for i in range(channels, stride):
            line[i] = (line[i] + line[i - channels]) & 255
    elif f == 2:
        for i in range(stride):
            line[i] = (line[i] + prev[i]) & 255
    elif f == 3:
        for i in range(stride):
            a = line[i - channels] if i >= channels else 0
            line[i] = (line[i] + ((a + prev[i]) >> 1)) & 255
    elif f == 4:
        for i in range(stride):
            a = line[i - channels] if i >= channels else 0
            b = prev[i]
            c = prev[i - channels] if i >= channels else 0
            pa, pb, pc = abs(b - c), abs(a - c), abs(a + b - 2 * c)
            line[i] = (line[i] + (a if pa <= pb and pa <= pc else (b if pb <= pc else c))) & 255
    out += line
    prev = line
PYEOF
)

# Where the first highlight colour is, as "x y", or nothing if the popup
# is not up.
#
# All four colours have to be there, evenly spaced, side by side on one
# row. A yellow highlight already on the page is otherwise
# indistinguishable from the yellow chip, and mistaking one for the other
# means tapping the page when the script believes it is tapping a button
# -- or, worse, tapping the button next to the one it meant, because
# every offset in this file is measured from where the first chip is.
#
# Averaging every pixel of a colour was what did that: a paragraph marked
# in yellow drags the yellow "chip" a long way left of the real one, and
# the row test still passes because the mark is on the same line as the
# popup. So the pixels are grouped into blobs first, and the answer is
# the one set of four blobs that sits in a row at the pitch the chips are
# laid out at.
#
#   find_popup   (reads $TINTS and the chip pitch in pixels)
find_popup() {
    adb exec-out screencap -p > "$work/screen.png" 2>/dev/null || return 1
    python3 -c "$PNG_DECODER
$(
        cat <<'PYEOF'
targets = [tuple(int(c[i:i + 2], 16) for i in (0, 2, 4)) for c in sys.argv[2].split(",")]
pitch = float(sys.argv[3])

STEP = 3
# Samples this far apart belong to the same blob. A chip is a disc wider
# than this; two chips are a gap wider still.
NEAR = 5 * STEP

blobs = []
for target in targets:
    cells = {}
    for y in range(0, height, STEP):
        row = y * stride
        for x in range(0, width, STEP):
            i = row + x * channels
            if all(abs(out[i + n] - target[n]) < 12 for n in range(3)):
                cells.setdefault((x // NEAR, y // NEAR), []).append((x, y))

    # Flood-fill the occupied cells into blobs.
    seen, groups = set(), []
    for cell in cells:
        if cell in seen:
            continue
        seen.add(cell)
        stack, group = [cell], []
        while stack:
            cx, cy = stack.pop()
            group += cells[(cx, cy)]
            for dx in (-1, 0, 1):
                for dy in (-1, 0, 1):
                    nxt = (cx + dx, cy + dy)
                    if nxt in cells and nxt not in seen:
                        seen.add(nxt)
                        stack.append(nxt)
        # A stray pixel of the right colour is not a chip; a chip is a disc.
        if len(group) >= 100:
            groups.append(
                (
                    sum(p[0] for p in group) // len(group),
                    sum(p[1] for p in group) // len(group),
                )
            )
    if not groups:
        sys.exit(1)
    blobs.append(groups)

# Four discs of different colours, evenly spaced along one line: that is
# the popup, and nothing else on a page of text looks like it.
best = None
for first in blobs[0]:
    row = [first]
    for others in blobs[1:]:
        want = row[-1][0] + pitch
        near = [
            b for b in others
            if abs(b[0] - want) <= pitch * 0.4 and abs(b[1] - first[1]) <= 12
        ]
        if not near:
            break
        row.append(min(near, key=lambda b: abs(b[0] - want)))
    if len(row) == len(blobs):
        best = row
        break

if best is None:
    sys.exit(1)
print(best[0][0], sum(b[1] for b in best) // len(best))
PYEOF
    )" "$work/screen.png" "$TINTS" "$(dp $POPUP_CHIP_PITCH_DP)"
}

# How much of the lower half of the page is ink, in tenths of a percent.
# The page a book was left on can be the last one of a chapter, which is
# a fine place to be reading and a poor thing to publish a picture of:
# three lines at the top and white below them say nothing about how the
# app uses a wide screen.
page_ink() {
    adb exec-out screencap -p > "$work/screen.png" 2>/dev/null || return 1
    python3 -c "$PNG_DECODER
$(
        cat <<'PYEOF'
dark = seen = 0
for y in range(height // 2, height, 4):
    row = y * stride
    for x in range(0, width, 4):
        i = row + x * channels
        seen += 1
        if sum(out[i:i + 3]) / 3 < 160:
            dark += 1
print(int(1000 * dark / seen))
PYEOF
    )" "$work/screen.png"
}

# Turn pages until one of them is worth photographing.
page_to_a_full_page() {
    local i ink
    for i in 1 2 3 4 5 6; do
        ink=$(page_ink || echo 0)
        note "the page is ${ink}/1000 ink"
        [[ $ink -ge 20 ]] && return 0
        turn_pages 1
    done
    die "no page with enough text on it after six turns"
}

x() { printf '%.0f' "$(awk "BEGIN { print $width * $1 }")"; }
y() { printf '%.0f' "$(awk "BEGIN { print $height * $1 }")"; }
# A fraction of the way down from another fraction, in pixels.
down() { y "$(awk "BEGIN { print $1 + $2 }")"; }
tap() { adb shell input tap "$(x "$1")" "$(y "$2")"; }

# Put a sheet away and make sure it went. A sheet that has been dragged
# up to its full height can eat the first back press on the way to
# settling, and the next step then taps into a sheet it thinks is gone.
#
#   dismiss_sheet <something the sheet says>
dismiss_sheet() {
    local needle=$1 i
    for i in 1 2 3; do
        back
        sleep 2
        on_screen "$needle" || return 0
    done
    die "\"$needle\" would not go away"
}

# A long press: a swipe that barely moves, held long enough for the page
# to treat it as a word being picked rather than a tap.
hold() {
    local px py
    px=$(x "$1")
    py=$(y "$2")
    adb shell input swipe "$px" "$py" "$((px + 2))" "$((py + 2))" 1500
    sleep 3
}

# Press a word until the selection popup appears, trying a few places
# down the page: a press that lands in a margin selects nothing. An x
# across the column can be given to land on a different word.
select_a_word() {
    local across=${1:-0.45}
    local spot
    for spot in 0.45 0.55 0.35 0.65; do
        reader_chrome_down
        hold "$across" "$spot"
        if find_popup >/dev/null; then
            return 0
        fi
    done
    return 1
}

# Press and drag along a line to take in a run of words. The notebook is
# what these marks are for, and a list of single words -- "over", "to" --
# says nothing about the book; a phrase reads like something a person
# would have marked on purpose.
#
# With "long", the drag runs several lines down the page instead of
# along one. The notebook caps a mark at four lines and offers to open it
# out; a one-line phrase never reaches that cap, and the picture of a
# long mark being read in full then has nothing long in it.
#
# The press has to register before the finger moves, so this cannot be a
# swipe: hold the finger down, wait out the long press, and only then
# drag. The gesture runs in one shell so the wait is the device's own.
select_a_phrase() {
    local span=${1:-short} spot py
    local -a xs ys
    for spot in 0.45 0.55 0.35 0.65; do
        reader_chrome_down
        py=$(y "$spot")
        # A wide screen lays the page out in two columns, and a drag
        # across the whole width crosses the gutter: what comes back is
        # the tail of one column, which reads like nothing anyone meant
        # to mark. Stay inside the left column there, and go down a
        # couple of lines to make up the length the narrower measure
        # costs. A phone has the whole width to itself and keeps it.
        if [[ $span == long ]]; then
            # Down the page rather than across it: where a line ends is
            # a property of the type size, and the only measure that
            # holds at every size is the page itself.
            if [[ $shot_class == phone ]]; then
                xs=(0.14 0.70 0.25 0.75 0.30 0.82)
            else
                xs=(0.10 0.40 0.14 0.42 0.16 0.44)
            fi
            ys=(
                "$py"
                "$py"
                "$(down "$spot" 0.035)"
                "$(down "$spot" 0.070)"
                "$(down "$spot" 0.105)"
                "$(down "$spot" 0.105)"
            )
        elif [[ $shot_class == phone ]]; then
            xs=(0.18 0.32 0.46 0.60 0.74 0.86)
            ys=("$py" "$py" "$py" "$py" "$py" "$py")
        else
            xs=(0.10 0.20 0.34 0.42 0.16 0.38)
            ys=(
                "$py"
                "$py"
                "$py"
                "$py"
                "$(down "$spot" 0.017)"
                "$(down "$spot" 0.017)"
            )
        fi
        adb shell "input motionevent DOWN $(x "${xs[0]}") ${ys[0]}
            sleep 1
            input motionevent MOVE $(x "${xs[1]}") ${ys[1]}
            input motionevent MOVE $(x "${xs[2]}") ${ys[2]}
            input motionevent MOVE $(x "${xs[3]}") ${ys[3]}
            input motionevent MOVE $(x "${xs[4]}") ${ys[4]}
            input motionevent UP $(x "${xs[5]}") ${ys[5]}" >/dev/null 2>&1
        sleep 3
        if find_popup >/dev/null; then
            return 0
        fi
    done
    return 1
}

# What the definition card is showing, and the word it is about, as
# "<state> <word>".
#
# A card that is up is not a card worth photographing: definitions are
# off until someone turns them on, the fetch takes a moment, and a word
# can have no entry or no route to the site it lives on. Each of those
# reads as a different mistake -- a setting, a wait, another word, a
# network -- so each gets its own name rather than all of them coming
# back as an empty string.
#
#   found    senses are on the card
#   disabled the lookup has not been turned on
#   loading  the fetch is still out
#   missing  the site has no entry for this word
#   failed   the site could not be reached
#   none     no card at all
dictionary_card() {
    dump_ui || return 1
    python3 - "$work/ui.xml" <<'PY'
import re
import sys
import xml.etree.ElementTree as ET

try:
    nodes = list(ET.parse(sys.argv[1]).getroot().iter("node"))
except ET.ParseError:
    sys.exit(1)

texts = [(n.get("text") or "").strip() for n in nodes]
texts = [t for t in texts if t]


def any_starting(prefix):
    return any(t.lower().startswith(prefix) for t in texts)


# The card puts the word above everything else, and it is the only text
# on that screen standing on its own: the page behind it is paragraphs,
# and the sense headings come after.
word = next((t for t in texts if re.fullmatch(r"[A-Za-z'-]+", t)), "")

if any_starting("turn on definitions") or any_starting("definitions are off"):
    state = "disabled"
elif any_starting("looking it up"):
    state = "loading"
elif any_starting("no entry for"):
    state = "missing"
elif any_starting("could not reach"):
    state = "failed"
# A sense is numbered, which nothing else on the card is: that is what
# tells a real answer from a card that merely opened.
elif any(re.match(r"\d+\. \S", t) for t in texts):
    state = "found"
else:
    state = "none"

print(state, word)
PY
}

# Wait for the card to stop being busy, then say what it settled on.
# Wiktionary is quick when it is warm and slow when it is not, and a
# fixed sleep long enough for the cold case is a sleep spent staring at a
# finished card in every other.
dictionary_settled() {
    local waited=0 blank=0 line state
    while ((waited < 25)); do
        line=$(dictionary_card) || line="none "
        state=${line%% *}
        case $state in
            loading) blank=0 ;;
            # A card that is not there after a few looks is a Define that
            # never landed, not a slow one: stop waiting on it.
            none)
                blank=$((blank + 1))
                ((blank >= 3)) && break
                ;;
            *) break ;;
        esac
        sleep 2
        waited=$((waited + 2))
    done
    printf '%s\n' "$line"
}

# Run SQL against the app's database, on an emulator where run-as is
# allowed. The statement travels base64'd because it goes through two
# shells and a book's URL is a percent-encoded content:// URI: quoting it
# twice by hand is how a seeding step silently writes nothing.
db_exec() {
    local encoded
    encoded=$(printf '%s' "$1" | base64 | tr -d '\n')
    adb shell "echo $encoded | base64 -d | \
        run-as $APP_ID sqlite3 /data/data/$APP_ID/databases/liseur.db" 2>/dev/null |
        tr -d '\r'
}

# How many marks the library holds, which is how a seeding step tells
# whether it actually did anything.
annotation_count() {
    adb shell "run-as $APP_ID sqlite3 /data/data/$APP_ID/databases/liseur.db \
        'select count(*) from annotations;'" 2>/dev/null | tr -d '\r'
}

# Let go of a selection. A popup left up from the last mark is the reason
# a second one silently turns into a second tap on the first. A tap on
# the page clears it; Back would leave the book altogether.
dismiss_popup() {
    local i
    for i in 1 2 3; do
        find_popup >/dev/null || return 0
        tap 0.5 0.5
        sleep 2
        reader_chrome_down
    done
}

# Tap something in the selection popup, given where the first colour is.
tap_in_popup() {
    local what=$1 at chip_x chip_y
    at=$(find_popup) || return 1
    chip_x=${at% *}
    chip_y=${at#* }
    case $what in
        highlight) adb shell input tap "$chip_x" "$chip_y" ;;
        note) adb shell input tap "$((chip_x + $(dp $POPUP_NOTE_DP)))" "$chip_y" ;;
        define) adb shell input tap "$((chip_x + $(dp $POPUP_DEFINE_DP)))" "$chip_y" ;;
    esac
    sleep 2
}

shot() {
    local name=$1
    adb exec-out screencap -p > "$OUT_DIR/$name.png"
    note "$OUT_DIR/$name.png"
}

# ------------------------------------------------------------- the app

open_first_book() {
    local title=$1
    tap_on_shelf "$title"
    # The reader takes a while to lay the publication out.
    wait_for "Contents" 40 >/dev/null || sleep 8
    sleep 3
}

# Forward, a page at a time. The chrome has to be down first: with it up,
# a tap on the page edge only puts it away again, and the book stays
# exactly where it was.
turn_pages() {
    local count=$1 direction=${2:-forward} edge=0.85 i
    [[ $direction == back ]] && edge=0.15
    reader_chrome_down
    for ((i = 0; i < count; i++)); do
        tap "$edge" 0.5
        sleep 1
    done
    sleep 2
}

# The chrome comes and goes with a tap in the middle of the page.
show_chrome() {
    tap 0.5 0.5
    sleep 2
}

reader_chrome_up() {
    on_screen "Contents" || show_chrome
}

reader_chrome_down() {
    if on_screen "Contents"; then
        show_chrome
    fi
}

# Pick a reading theme by name in the typography sheet, rather than
# trusting whatever the device was left on: that is what stopped the
# light set from quietly coming out dark on a rerun.
choose_reading_theme() {
    local theme=$1
    # Opening the sheet is not always instant, and a dump taken while the
    # reader is still settling can come back without it. Rather than tap
    # where the swatch is meant to be, put the sheet away and open it
    # again.
    for _ in 1 2 3; do
        reader_chrome_up
        if tap_if_there "Aa" exact && wait_for "$theme" 15 exact >/dev/null; then
            tap_on "$theme" exact
            sleep 2
            back
            sleep 2
            return 0
        fi
        back
        sleep 3
    done
    die "could not pick the $theme reading theme"
}

# --------------------------------------------------------------- setup

# The reader screens are captured from the first book, so it has to look
# like a book someone has been reading: a few pages in, with marks on the
# page it reopens on and a notebook worth showing.
seed_reading() {
    local marks
    marks=$(adb shell "run-as $APP_ID sqlite3 /data/data/$APP_ID/databases/liseur.db \
        'select count(*) from annotations;'" 2>/dev/null | tr -d '\r')
    if [[ ${marks:-0} -gt 0 ]]; then
        note "the shelf already carries marks; leaving them alone"
        return 0
    fi

    open_library
    open_first_book "Moby Dick"

    # Jump to the first chapter. Paging in from the front lands in the
    # epigraphs, which are a wall of quotations and attributions and make
    # a poor picture of what reading the app is like. How many pages that
    # takes depends on the type size, so go by the chapter rather than by
    # counting taps.
    reader_chrome_up
    tap_on "Contents"
    tap_on "$FIRST_CHAPTER"
    sleep 4
    reader_chrome_down

    # A few pages in, so the page opens on prose rather than a heading.
    turn_pages 3

    # A mark on each of three pages, so the notebook has something to
    # list. Each is checked against the database, because a highlight
    # that quietly failed looks exactly like one that worked.
    #
    # The first runs down the page rather than along a line: the notebook
    # only offers to open a mark out once it is longer than four lines,
    # and a shelf of one-line marks has nothing to photograph that with.
    local before after span
    for span in long short short; do
        dismiss_popup
        before=$(annotation_count)
        if select_a_phrase "$span"; then
            tap_in_popup highlight
            sleep 2
            after=$(annotation_count)
            if [[ ${after:-0} -gt ${before:-0} ]]; then
                note "highlighted a $span passage"
            else
                note "the highlight did not take"
            fi
        fi
        dismiss_popup
        # Well clear of the mark just made: a selection that overlaps one
        # edits it instead of adding another, and the count never moves.
        turn_pages 2
    done

    # A note, on a page of its own.
    dismiss_popup
    turn_pages 2
    before=$(annotation_count)
    if select_a_phrase; then
        tap_in_popup note
        if wait_for "What did this make you think" 10 >/dev/null; then
            # Save stays greyed out until the note has words in it, and
            # typing only reaches the field once it holds the cursor.
            tap_on "What did this make you think"
            sleep 1
            adb shell input text "${HIGHLIGHT_NOTE// /%s}"
            sleep 1
            tap_on "Save" exact
            sleep 3
            after=$(annotation_count)
            if [[ ${after:-0} -gt ${before:-0} ]]; then
                note "left a note"
            else
                note "the note did not take"
            fi
        fi
    fi

    dismiss_popup
    reader_chrome_up
    # The bookmark is the one mark taken from the chrome, and a tap there
    # that lands on nothing looks exactly like a tap that worked: the
    # button stays where it was and the run carries on. So the label has
    # to turn over and the row has to appear. This reported a bookmark it
    # had never taken, and the demo shelf shipped without one.
    #
    # A page already carrying one is left as it is: tapping would take
    # the mark off, and the shelf would end up as bare as before.
    if on_screen "Remove bookmark"; then
        note "the page was already bookmarked"
    else
        before=$(annotation_count)
        tap_on "Bookmark this page"
        wait_for "Remove bookmark" 10 >/dev/null ||
            die "the bookmark button did not take the mark"
        after=$(annotation_count)
        [[ ${after:-0} -gt ${before:-0} ]] ||
            die "the bookmark button turned over without writing a mark"
        note "bookmarked the page"
    fi
    reader_chrome_down

    # Back to a page carrying a highlight, because that is the page the
    # reader screenshots open on.
    turn_pages 4 back
}

# The reading history the stats screens are made of.
#
# A shelf seeded an hour ago has none, and the heatmap, the streak and
# the totals are then a picture of an app nobody has used. Reading it for
# real would take weeks, so the sittings are written straight into the
# table the reader would have filled -- which is an emulator thing to do,
# and one of the reasons this script refuses to guess a device.
#
# Everything is measured back from now, so the heatmap is always recent
# and the streak is always live, and the shape is fixed rather than
# random: two runs a week apart should differ by a week, not by a
# different history.
readonly SESSION_SQL=$(
    cat <<'PYEOF'
import random
import sys

now = int(sys.argv[1])
# Where the reader really is in the book the reading screens are taken
# in. The sittings against that book have to add up to it: a card saying
# twelve hours against three per cent of a novel is a picture of a bug,
# and it is the one book whose position anybody can check, because every
# other screenshot in the set shows the page it is open at.
on_screen_at = float(sys.argv[2])
urls = [line.strip() for line in sys.stdin if line.strip()]
if not urls:
    sys.exit(1)

random.seed(20260828)

DAY = 86_400
# A percent of a book for every twelve minutes read, which is about right
# for a novel of the length these are and makes the time-left estimate
# under the bar read like a real one.
PER_MINUTE = 1 / 1200

# The bulk of the reading goes into books the tour never opens, which is
# what gives the "By book" list its depth. Those carry no saved place, so
# the screen shows their hours without claiming a percentage, and nothing
# has to be invented to make the two agree.
on_screen_book = urls[0]
shelf = urls[1:4] or [on_screen_book]
weights = [0.45, 0.33, 0.22][:len(shelf)]
progress = {url: 0.02 for url in shelf}

rows = []


def sitting(url, days_ago, minutes, start_at, end_at):
    hour = random.choice([8, 13, 19, 21, 22])
    started = (now - days_ago * DAY) * 1000
    started += (hour * 3600 + random.randint(0, 1800)) * 1000
    if started > now * 1000:
        started = (now - random.randint(1800, 7200)) * 1000
    duration = minutes * 60 * 1000
    idle = random.randint(0, 4) * 60 * 1000
    rows.append(
        "({url},{started},{ended},{ended},{duration},{start_at},{end_at},{idle})".format(
            url="'" + url.replace("'", "''") + "'",
            started=started,
            ended=started + duration + idle,
            duration=duration,
            start_at=round(start_at, 4),
            end_at=round(end_at, 4),
            idle=idle,
        )
    )


for days_ago in range(41, -1, -1):
    # The last few days always count, so the streak on the card is a real
    # one rather than whatever the dice left behind.
    if days_ago > 4 and random.random() < 0.35:
        continue
    for _ in range(random.choice([1, 1, 1, 2])):
        url = random.choices(shelf, weights=weights)[0]
        minutes = random.randint(14, 72)
        start_at = progress[url]
        end_at = min(0.99, start_at + minutes * PER_MINUTE)
        progress[url] = end_at
        sitting(url, days_ago, minutes, start_at, end_at)

# And the book on screen, in as much reading as the place it is really at
# is worth: an evening and a bus ride, for an opening chapter.
budget = max(2, round(on_screen_at / PER_MINUTE))
at = 0.0
for days_ago in (3, 1):
    minutes = max(1, budget // 2)
    budget -= minutes
    end_at = at + minutes * PER_MINUTE
    sitting(on_screen_book, days_ago, minutes, at, end_at)
    at = end_at

if not rows:
    sys.exit(1)

print("INSERT INTO reading_sessions")
print("(book_url, started_at, ended_at, last_checkpoint_at, duration_ms,")
print(" start_progression, end_progression, idle_ms) VALUES")
print(",\n".join(rows) + ";")
PYEOF
)

seed_sessions() {
    local days urls at sql count
    # Opening a book once writes a sitting, so a shelf with reading on it
    # is not a shelf with a history on it: what the stats screens are
    # made of is days, and a handful of them is what makes a heatmap.
    days=$(db_exec 'select count(distinct date(started_at/1000, "unixepoch")) from reading_sessions;')
    if [[ ${days:-0} -ge 5 ]]; then
        note "the shelf already carries reading on $days days; leaving it alone"
        return 0
    fi

    # The book the reader screens are taken in goes first, so the history
    # can be written to agree with where it is really open.
    urls=$(db_exec "select url from books order by (title like 'Moby%') desc, title;")
    [[ -n $urls ]] || die "no books on the shelf to record reading against"
    at=$(db_exec "select coalesce(max(total_progression), 0.03) from reading_progress
        where book_url = '$(printf '%s' "$urls" | head -n 1)';")
    [[ -n $at ]] || at=0.03

    # Room hears about its own writes and nothing else, so a screen that
    # is already open would go on showing the empty history it read at
    # startup. Every step after this opens the app again anyway; stopping
    # it first is what makes that reopen honest.
    adb shell am force-stop "$APP_ID"

    sql=$(printf '%s\n' "$urls" | python3 -c "$SESSION_SQL" "$(date +%s)" "$at") ||
        die "could not work out a reading history"
    db_exec "$sql" >/dev/null
    count=$(db_exec 'select count(*) from reading_sessions;')
    [[ ${count:-0} -gt 0 ]] || die "the reading history did not take"
    note "recorded $count sittings"
}

# ------------------------------------------------------------- capture

mkdir -p "$OUT_DIR" "$FASTLANE_DIR"

printf 'Capturing from %s (%sx%s)\n' "$serial" "$width" "$height"

# A demo run should look like a considered library, not a debug session:
# a round clock, no notification icons, a full battery.
adb shell settings put global sysui_demo_allowed 1
adb shell am broadcast -a com.android.systemui.demo -e command enter >/dev/null
adb shell am broadcast -a com.android.systemui.demo -e command clock -e hhmm 1000 >/dev/null
adb shell am broadcast -a com.android.systemui.demo -e command notifications -e visible false >/dev/null
adb shell am broadcast -a com.android.systemui.demo -e command network \
    -e wifi show -e level 4 -e mobile hide >/dev/null
adb shell am broadcast -a com.android.systemui.demo -e command battery \
    -e level 100 -e plugged false >/dev/null

# A device that thinks it has a stylus offers to teach you handwriting
# the first time a text field is touched, and that dialog takes the
# typing meant for the field. Tablet images have one; phones mostly do
# not, which is why this only ever showed up on the big screens.
adb shell settings put secure stylus_handwriting_enabled 0 >/dev/null 2>&1 || true

# The empty library, which is the one screen the demo shelf makes
# impossible. Wiping the app's storage is the only honest way to reach
# it -- removing the folder would leave the books it had already read
# behind -- so this ends the run rather than carrying on through a tour
# whose shelf it has just thrown away.
if ((empty_only)); then
    step "The empty library"
    adb shell pm clear "$APP_ID" >/dev/null
    open_library
    # Wallpaper colours are the default on Android 12 and up, and the
    # rest of the set is captured in Liseur's own palette. A single
    # picture in the system's would be the odd one out in the README
    # table.
    open_settings
    set_switch "Colours from your wallpaper" off
    back
    sleep 2
    wait_for "Your library is empty" 20 >/dev/null ||
        die "the empty library never appeared"
    shot 16-empty-library

    adb shell cmd uimode night yes >/dev/null
    sleep 3
    wait_for "Your library is empty" 20 >/dev/null ||
        die "the empty library never came back in the dark"
    shot 17-empty-library-dark

    printf '\nDone. The shelf is gone with the storage: run --setup to build\n'
    printf 'it again before capturing the rest.\n'
    exit 0
fi

if ((setup)); then
    step "Fetching the demo shelf"
    fetch_books
    push_books
    step "Granting the folder"
    grant_folder
    step "Making the first book look read"
    seed_reading
    step "Recording some reading"
    seed_sessions
fi

if ((setup_only)); then
    printf '\nShelf ready. Run again without --setup to capture.\n'
    exit 0
fi

step "Light"

# Screenshots show Liseur's own palette, not the emulator's wallpaper.
# Wallpaper colours are the default on Android 12 and up, which would
# otherwise make every capture depend on whatever image the emulator
# happens to be showing -- and would tell a store visitor nothing about
# what the app looks like.
open_library
open_settings
set_switch "Colours from your wallpaper" off

# The definition card is the one picture that needs a setting turned on:
# a lookup is off until someone asks for it, and Define otherwise offers
# to turn it on rather than saying anything about the word. What it was
# before is remembered and put back at the end, because it is a decision
# about who the device talks to and not a capture setting.
dictionary_before=""
if ((want_dictionary)) && [[ $shot_class == phone ]]; then
    scroll_to "$DICTIONARY_SWITCH" ||
        die "no \"$DICTIONARY_SWITCH\" switch in Settings"
    dictionary_before=$(switch_state "$DICTIONARY_SWITCH") ||
        die "could not read the \"$DICTIONARY_SWITCH\" switch"
    set_switch "$DICTIONARY_SWITCH" on
fi
back

if [[ $shot_class == tablet ]]; then
    step "The tablet set"
    # Three pictures, not a second copy of the phone tour. A store
    # visitor on a tablet already knows what a settings screen looks
    # like; what they cannot tell from the phone set is whether the app
    # uses the width they paid for.
    open_library
    shelf_to_top
    shot 03-library

    open_first_book "Moby Dick"
    choose_reading_theme "Light"
    reader_chrome_down
    page_to_a_full_page
    shot 01-two-columns

    reader_chrome_up
    tap_on "Aa" exact
    wait_for "Theme" >/dev/null || sleep 2
    # The Columns control only exists on a wide screen, and it sits below
    # the fold, so scroll it into frame. Swiping up scrolls the sheet's
    # content; it is swiping down at the top that would dismiss it.
    adb shell input swipe "$(x 0.5)" "$(y 0.92)" "$(x 0.5)" "$(y 0.72)" 400
    sleep 2
    on_screen "Columns" || die "the Columns control never came into frame"
    shot 02-columns-control
    dismiss_sheet "Line spacing"

    step "The F-Droid set"
    i=1
    for name in 01-two-columns 02-columns-control 03-library; do
        cp "$OUT_DIR/$name.png" "$FASTLANE_DIR/$i.png"
        note "$FASTLANE_DIR/$i.png"
        i=$((i + 1))
    done

    printf '\nDone. Look at the images before committing: a screen can be found\n'
    printf 'and still be showing the wrong thing.\n'
    exit 0
fi

open_library
shelf_to_top
shot 01-library

open_first_book "Moby Dick"
choose_reading_theme "Light"
reader_chrome_down
shot 02-reading

reader_chrome_up
shot 03-chrome

tap_on "Aa" exact
wait_for "Theme" >/dev/null || sleep 2
shot 04-typography

# Everything a reader sets once, if ever, is behind the one row at the
# bottom of that sheet -- which is the whole bargain of
# docs/adr/0001-advanced-reading-menu.md, and worth a picture of its own
# so the short sheet above is not read as all there is.
scroll_to "Advanced" exact || die "no Advanced row in the typography sheet"
tap_on "Advanced" exact
wait_for "$ADVANCED_MARKER" 15 >/dev/null ||
    die "the Advanced sheet never opened"
shot 20-advanced
dismiss_sheet "$ADVANCED_MARKER"
dismiss_sheet "Advanced"

reader_chrome_up
tap_on "Contents"
shot 05-contents

tap_on "Highlights"
sleep 2
shot 06-highlights

# A mark longer than four lines is listed cut short, with a way to read
# the rest of it where it is. Seeding makes one of the three that long
# on purpose; nothing else in the notebook is.
scroll_to "Show more" exact ||
    die "no mark long enough to open out; reseed the shelf with --setup"
tap_on "Show more" exact
sleep 2
shot 21-navigate
back
sleep 2

step "In-book search"
# The search field has to have taken focus before the text is sent, and
# it does not always get there first: a tablet image offers to teach you
# stylus handwriting the first time a text field is touched, and that
# dialog takes the typing meant for the field. Typing into nothing then
# photographs an empty search screen and calls it a result. So type, look
# at what came back, and start the whole thing over if it was nothing.
searched=0
for attempt in 1 2 3; do
    reader_chrome_up
    tap_on "Search in book"
    sleep 2
    adb shell input text "$SEARCH_TERM"
    sleep 1
    adb shell input keyevent KEYCODE_ENTER
    # A long book takes a moment; a short wait would call it empty.
    wait_for "result" 20 contains >/dev/null && searched=1 && break
    note "the search box did not take the word; starting over"
    # Back out of whatever is on top until the reader is showing again.
    for i in 1 2 3 4; do
        on_screen "Search in this book" || break
        back
        sleep 1
    done
done
[[ $searched -eq 1 ]] || die "the search never returned anything for \"$SEARCH_TERM\""
# Drop the keyboard so the results, not the letters, fill the screen.
back
sleep 2
shot 07-search
back
sleep 3

step "A definition"
# "the" is a word with an entry, so the screen would be found and would
# still be worth nothing to look at. Press elsewhere until the card is
# about a word someone might actually look up. Where a press lands on a
# word worth reading about is luck, and there is more of it to be had on
# a page laid out in two columns, so there are plenty of places to try.
#
# What the card says is read back rather than assumed, because every way
# this goes wrong looks the same from outside: the lookup switched off,
# the fetch still out, no entry for the word, no route to the site. Only
# one of those is worth trying another word for, and none of them is
# worth publishing.
if ((want_dictionary)); then
    defined=0
    for across in 0.60 0.35 0.72 0.50 0.28 0.66 0.42 0.78 0.55 0.31; do
        select_a_word "$across" || continue
        tap_in_popup define
        read -r card_state card_word < <(dictionary_settled)
        note "the card came back ${card_state} about \"${card_word:-nothing}\""
        case $card_state in
            found)
                # A card about "the" is a card that is working and still
                # says nothing; keep pressing until the word is one
                # somebody might really have stopped on.
                if [[ ${#card_word} -ge 6 ]]; then
                    shot 12-dictionary
                    defined=1
                    back
                    sleep 2
                    break
                fi
                note "\"$card_word\" is not worth a picture; trying another word"
                ;;
            disabled)
                die "the definition lookup is off: the \"$DICTIONARY_SWITCH\" switch did not take"
                ;;
            failed)
                die "the device could not reach the dictionary; run with --no-dictionary if that is expected"
                ;;
            missing) note "no entry for \"$card_word\"; trying another word" ;;
            loading) note "the lookup never came back; trying another word" ;;
            none) note "no card came up; trying another word" ;;
        esac
        back
        sleep 2
    done
    ((defined)) || die "no word on the page produced a definition worth photographing"
else
    note "skipping the definition card"
fi

step "Series"

# The Series view only exists once the shelf holds a series, which the
# demo books provide. Failing here is right: a run that quietly captured
# the plain shelf twice would publish a picture of a feature that is not
# in it.
open_library
# The filter button carries a summary of what is in force rather than a
# fixed word, so the way in is whatever it reads now: grouping is a view
# mode rather than a narrowing, is not counted in that summary, and with
# nothing ticked it reads the bare "Filter". The menu stays open under a
# tap -- boxes are meant to be ticked several at a time -- so Back is
# what closes it.
toggle_grouping() {
    shelf_to_top
    tap_on "Filter"
    sleep 1
    tap_on "Group by series"
    sleep 1
    back
    sleep 3
}

# Nothing on screen says whether the grouping is on, and the menu row is
# drawn without a checkable box, so `set_switch` cannot read it. What
# says it is the card: grouped, a series is a pile of covers under the
# series' own name, "Sherlock Holmes"; ungrouped, that name only ever
# appears as the "Sherlock Holmes · #5" line under a volume. So the
# needle has to be exact -- a prefix matches both, which is how a run
# photographed the plain shelf, tapped a subtitle and opened a book.
#
# A run that died mid-tour leaves the grouping on and the first toggle
# turns it off, so try twice before believing there are no series. The
# shelf also keeps its sort under grouping, and with Recent in force --
# which is what seeded reading leaves behind -- a series sits wherever
# its newest volume was last opened rather than at the top.
grouped=0
for attempt in 1 2; do
    toggle_grouping
    if scroll_to "Sherlock Holmes" exact; then
        grouped=1
        break
    fi
done
((grouped)) || die "the Series view never showed a series"
shot 13-series

# Into one series: the volumes in order, where you are in it, and the
# ones missing in between.
tap_on_shelf "Sherlock Holmes" exact
sleep 3
on_screen "The Hound of the Baskervilles" ||
    die "the series screen never opened"
shot 14-series-detail
back
sleep 2
# Back to the whole shelf, so the screens after this start where the
# earlier ones did. The grouping is written down now and survives a
# restart, so leaving this on would quietly put every later shelf into
# series view. It is not a filter, so it is not in the button's summary
# and "Clear filters" does not reach it: the way back off is the way it
# went on.
toggle_grouping

step "Reading stats"

# What the shelf has been read for: the hours, the streak, and the days
# they landed on. The history behind this is seeded, because a demo
# device has none and reading forty days of it is not a screenshot step.
open_library
tap_on "More" exact
tap_on "Reading stats"
wait_for "Time spent reading" 20 >/dev/null ||
    die "the reading stats screen never opened"
on_screen "Nothing recorded yet" &&
    die "the stats screen has no reading on it; reseed the shelf with --setup"
shot 18-stats

# And the same for one book, which is where the pace and what is left of
# it are worked out.
scroll_to "Moby Dick" || die "no book listed under the reading stats"
tap_on "Moby Dick"
sleep 3
wait_for "Last read" 20 >/dev/null ||
    die "the book's reading stats never opened"
shot 19-stats-book
back
sleep 2
back
sleep 2

step "Settings"
open_library
open_settings
shot 08-settings

# Exactly, because the heading above the row now carries an
# information button described as "Book servers", and a prefix match
# reaches that first: the tap opens the explainer over the settings form
# and the picture is of a dialog rather than of a server.
tap_on "Book server" exact
sleep 3
shot 09-server

# Every kind at once: what each server is for, and whether your place in
# a book will follow you there. The row says only which one is picked, so
# the sheet under it is the picture worth having.
tap_on "Which kind of server?"
wait_for "Grimmory" 15 >/dev/null || die "the server kind sheet never opened"
shot 22-server-kind
dismiss_sheet "Grimmory"

step "Dark"

adb shell cmd uimode night yes >/dev/null
sleep 3

open_library
shelf_to_top
shot 10-library-dark

open_first_book "Moby Dick"
choose_reading_theme "Dark"
reader_chrome_down
sleep 2
shot 11-reading-dark

# Put the reading theme back, so a rerun starts where this one did.
choose_reading_theme "Light"
reader_chrome_down

# And the definition lookup, if this run is what turned it on. Whether
# the device may talk to a dictionary is the reader's answer, not a
# capture setting, so it goes back to whatever it was.
if [[ $dictionary_before == off ]]; then
    open_library
    open_settings
    scroll_to "$DICTIONARY_SWITCH" ||
        die "no \"$DICTIONARY_SWITCH\" switch to put back"
    set_switch "$DICTIONARY_SWITCH" off
    back
fi

step "The F-Droid set"
i=1
# All light. A dark screenshot in a store listing is read as the app
# looking like that, rather than as the app being able to; the dark
# theme is worth more as a line in the description than as one picture
# in six that does not match the other five.
#
# All six now come from this one run. An empty shelf used to be among
# them, which meant the set could only be completed by a second command
# with a different flag -- and it was the weakest of the six anyway:
# nothing sells a reader like the hours somebody has already put into it.
for name in 01-library 02-reading 13-series 04-typography 18-stats 06-highlights; do
    [[ -f "$OUT_DIR/$name.png" ]] ||
        die "no $OUT_DIR/$name.png: the step that takes it did not run"
    cp "$OUT_DIR/$name.png" "$FASTLANE_DIR/$i.png"
    note "$FASTLANE_DIR/$i.png"
    i=$((i + 1))
done

printf '\nDone. Look at the images before committing: a screen can be found\n'
printf 'and still be showing the wrong thing.\n'
