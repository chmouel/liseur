#!/usr/bin/env bash
#
# Capture the screenshots used by the README and by F-Droid.
#
# Everything is driven through adb against a running emulator or device, so
# the images can be regenerated after a UI change instead of drifting.
#
#   hack/screenshots                 # use the only attached device
#   hack/screenshots emulator-5554   # pick one explicitly
#
# What the device needs first:
#
#   * the app installed, with a library folder granted;
#   * books whose covers can be published — the shelf ends up in the README
#     and on F-Droid, so use public domain editions (Standard Ebooks is
#     ideal) rather than whatever you happen to own;
#   * the book that sorts first must be part-read and carry a few
#     highlights, notes and bookmarks, because the notebook screens are
#     captured from it;
#   * calibre-web signed out, unless your server holds only books you are
#     willing to publish a picture of.
#
# Nothing here writes to a server.

set -euo pipefail

readonly APP_ID="com.chmouel.liseur"
readonly MAIN_ACTIVITY="$APP_ID/.MainActivity"
readonly OUT_DIR="docs/screenshots"
readonly FASTLANE_DIR="fastlane/metadata/android/en-US/images/phoneScreenshots"

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

serial=${1:-}
if [[ -z "$serial" ]]; then
    mapfile -t devices < <(adb devices | awk 'NR > 1 && $2 == "device" { print $1 }')
    [[ ${#devices[@]} -eq 1 ]] ||
        die "expected exactly one attached device, got ${#devices[@]}; pass a serial"
    serial=${devices[0]}
fi

adb() { command adb -s "$serial" "$@"; }

shot() {
    local name=$1
    adb exec-out screencap -p > "$OUT_DIR/$name.png"
    printf '  %s\n' "$OUT_DIR/$name.png"
}

# Screen coordinates are computed from the real display size rather than
# hard-coded, so this keeps working on a differently sized device.
read -r width height < <(
    adb shell wm size | sed -nE 's/.*: ([0-9]+)x([0-9]+)/\1 \2/p' | tail -n 1
)
[[ -n "$width" && -n "$height" ]] || die "could not read the display size"

x() { printf '%.0f' "$(awk "BEGIN { print $width * $1 }")"; }
y() { printf '%.0f' "$(awk "BEGIN { print $height * $1 }")"; }

tap() { adb shell input tap "$(x "$1")" "$(y "$2")"; }
back() { adb shell input keyevent KEYCODE_BACK; }

# Landmarks, as fractions of the display.
readonly TOP_BAR=0.092          # every top bar sits at the same height
readonly LIB_FIRST_BOOK_X=0.18  # the first cover on the shelf
readonly LIB_FIRST_BOOK_Y=0.32
readonly LIB_SETTINGS_X=0.698
readonly READER_SEARCH_X=0.696
readonly READER_TYPOGRAPHY_X=0.815
readonly READER_CONTENTS_X=0.932
readonly SHEET_CLOSE_X=0.070
readonly TABS_Y=0.152
readonly TAB_HIGHLIGHTS_X=0.623
readonly THEME_SWATCH_Y=0.614
readonly THEME_LIGHT_X=0.126
readonly THEME_DARK_X=0.476
readonly SETTINGS_CALIBRE_Y=0.868
# A word in the middle of the open page, and where the selection popup's
# "Define" lands once that word is held down. Both are tied to the page
# the first book reopens on, like the annotations are.
readonly PAGE_WORD_X=0.433
readonly PAGE_WORD_Y=0.435
readonly POPUP_DEFINE_X=0.590
readonly POPUP_DEFINE_Y=0.313

command -v adb >/dev/null || die "adb is not installed"
adb shell pm path "$APP_ID" >/dev/null 2>&1 || die "$APP_ID is not installed"

mkdir -p "$OUT_DIR" "$FASTLANE_DIR"

printf 'Capturing from %s (%sx%s)\n' "$serial" "$width" "$height"

# A demo run should look like a considered library, not a debug session:
# hide the clock's seconds, the notification icons and the network state.
adb shell settings put global sysui_demo_allowed 1
adb shell am broadcast -a com.android.systemui.demo -e command enter >/dev/null
adb shell am broadcast -a com.android.systemui.demo -e command clock -e hhmm 1000 >/dev/null
adb shell am broadcast -a com.android.systemui.demo -e command notifications -e visible false >/dev/null
adb shell am broadcast -a com.android.systemui.demo -e command network \
    -e wifi show -e level 4 -e mobile hide >/dev/null
adb shell am broadcast -a com.android.systemui.demo -e command battery \
    -e level 100 -e plugged false >/dev/null

restore_device() {
    adb shell am broadcast -a com.android.systemui.demo -e command exit >/dev/null || true
    adb shell cmd uimode night no >/dev/null || true
}
trap restore_device EXIT

open_library() {
    adb shell am force-stop "$APP_ID"
    adb shell am start -n "$MAIN_ACTIVITY" >/dev/null
    sleep 8
    # The app opens on the book you were reading; step back to the shelf.
    if adb shell dumpsys activity activities | grep -q 'ReaderActivity.*t[0-9]'; then
        back
        sleep 3
    fi
}

# The first book on the shelf is the one read most recently, which is also
# the one carrying the annotations, and it reopens where it was left.
open_book() {
    tap "$LIB_FIRST_BOOK_X" "$LIB_FIRST_BOOK_Y"
    sleep 10
}

show_chrome() {
    tap 0.5 0.5
    sleep 2
}

# A long press is a swipe that goes nowhere.
hold() {
    local px py
    px=$(x "$1")
    py=$(y "$2")
    adb shell input swipe "$px" "$py" "$px" "$py" 900
}

# Pick a reading theme by its swatch in the typography sheet. Doing this
# explicitly rather than trusting whatever the device was left on is what
# keeps a rerun from quietly capturing the light set on a dark page.
choose_reading_theme() {
    local swatch_x=$1
    tap "$READER_TYPOGRAPHY_X" "$TOP_BAR"
    sleep 3
    tap "$swatch_x" "$THEME_SWATCH_Y"
    sleep 2
    back
    sleep 2
}

printf 'Light\n'

open_library
shot 01-library

open_book
show_chrome
choose_reading_theme "$THEME_LIGHT_X"
show_chrome
shot 02-reading

show_chrome
shot 03-chrome

tap "$READER_TYPOGRAPHY_X" "$TOP_BAR"
sleep 3
shot 04-typography
back
sleep 2

tap "$READER_CONTENTS_X" "$TOP_BAR"
sleep 3
shot 05-contents

tap "$TAB_HIGHLIGHTS_X" "$TABS_Y"
sleep 2
shot 06-highlights
tap "$SHEET_CLOSE_X" "$TOP_BAR"
sleep 3

# In-book search, with a word common enough to fill the results.
tap "$READER_SEARCH_X" "$TOP_BAR"
sleep 3
adb shell input text "whale"
sleep 1
adb shell input keyevent KEYCODE_ENTER
sleep 6
# Drop the keyboard so the results, not the letters, fill the screen.
back
sleep 2
shot 07-search
back
sleep 3

# Hold a word to get the selection popup, then look it up on Wiktionary.
show_chrome
hold "$PAGE_WORD_X" "$PAGE_WORD_Y"
sleep 3
tap "$POPUP_DEFINE_X" "$POPUP_DEFINE_Y"
sleep 7
shot 12-dictionary
back
sleep 2

open_library
tap "$LIB_SETTINGS_X" "$TOP_BAR"
sleep 3
shot 08-settings

tap 0.5 "$SETTINGS_CALIBRE_Y"
sleep 3
shot 09-calibre

printf 'Dark\n'

adb shell cmd uimode night yes >/dev/null
sleep 2

open_library
shot 10-library-dark

open_book
show_chrome
choose_reading_theme "$THEME_DARK_X"
# Hide the chrome again: the point of this one is the page itself.
show_chrome
sleep 2
shot 11-reading-dark

# Put the reading theme back, so a rerun starts from the same place.
show_chrome
choose_reading_theme "$THEME_LIGHT_X"

printf 'Copying the F-Droid set\n'
i=1
for name in 01-library 02-reading 06-highlights 04-typography 11-reading-dark 08-settings; do
    cp "$OUT_DIR/$name.png" "$FASTLANE_DIR/$i.png"
    printf '  %s/%s.png\n' "$FASTLANE_DIR" "$i"
    i=$((i + 1))
done

printf 'Done. Check the images before committing: the script drives the UI\n'
printf 'blind, so a changed layout can quietly produce the wrong screen.\n'
