#!/usr/bin/env bash
#
# Capture the screenshots used by the README and by F-Droid.
#
#   hack/screenshots --setup      # build a demo shelf first, then capture
#   hack/screenshots              # capture from a device already set up
#   hack/screenshots --setup-only # build the shelf and stop, to check it
#   hack/screenshots -s SERIAL    # pick a device when several are attached
#   hack/screenshots --class tablet   # file the captures as a tablet set
#
# Which set is written is decided by how wide the device is, so a run
# against a tablet cannot quietly overwrite the phone screenshots the
# README embeds. --class overrides the guess.
#
# The screens are found by what they say — a button's label, a book's
# title — rather than by where they happened to sit when this was
# written. A moved control is then a control the script waits for and
# fails on, instead of a tap into empty space and a screenshot of the
# wrong thing.
#
# --setup builds the shelf from scratch: it downloads a handful of
# Standard Ebooks editions (public domain, cover art included, which is
# what makes them publishable), pushes them to the device, grants the
# folder through the real picker, and leaves the first book part-read
# with a highlight, a note and a bookmark on it. Everything the notebook
# and the reader screens need is then really there.
#
# Nothing here writes to a calibre-web server. Sign out of one before
# running if your server holds books you would not publish a picture of.

set -euo pipefail

readonly APP_ID="com.chmouel.liseur"
readonly MAIN_ACTIVITY="$APP_ID/.MainActivity"
readonly DEVICE_BOOKS="/sdcard/Books"

# shellcheck source=hack/lib/demo-books.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/demo-books.sh"

# The word held down to raise the selection popup, and the one searched
# for in-book. Both are Moby Dick's, which is the book that opens first.
readonly HIGHLIGHT_NOTE="The line that gives the book its weather."
readonly SEARCH_TERM="whale"

# The chapter the reader screenshots are taken in, as the contents sheet
# spells it. Moby Dick's again, and its first.
readonly FIRST_CHAPTER="I: Loomings"

setup=0
setup_only=0
serial=""
shot_class=""
while [[ $# -gt 0 ]]; do
    case $1 in
        --setup) setup=1 ;;
        --setup-only)
            setup=1
            setup_only=1
            ;;
        -s | --serial)
            serial=${2:-}
            shift
            ;;
        --class)
            shot_class=${2:-}
            shift
            ;;
        -h | --help)
            sed -n '3,30p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            printf 'error: unknown argument %s\n' "$1" >&2
            exit 1
            ;;
    esac
    shift
done

command -v adb >/dev/null || die "adb is not installed"
command -v python3 >/dev/null || die "python3 is not installed"

if [[ -z "$serial" ]]; then
    mapfile -t devices < <(adb devices | awk 'NR > 1 && $2 == "device" { print $1 }')
    [[ ${#devices[@]} -eq 1 ]] ||
        die "expected exactly one attached device, got ${#devices[@]}; pass --serial"
    serial=${devices[0]}
fi

adb() { command adb -s "$serial" "$@"; }

adb shell pm path "$APP_ID" >/dev/null 2>&1 ||
    die "$APP_ID is not installed on $serial"

read -r width height < <(
    adb shell wm size | sed -nE 's/.*: ([0-9]+)x([0-9]+)/\1 \2/p' | tail -n 1
)
[[ -n "$width" && -n "$height" ]] || die "could not read the display size"

work=$(mktemp -d)
cleanup() {
    adb shell am broadcast -a com.android.systemui.demo -e command exit >/dev/null 2>&1 || true
    adb shell cmd uimode night no >/dev/null 2>&1 || true
    adb shell rm -f /sdcard/liseur-ui.xml >/dev/null 2>&1 || true
    rm -rf "$work"
}
trap cleanup EXIT

# ---------------------------------------------------------------- the UI

# Settings now lives in the shelf's overflow menu rather than on the bar,
# so it has to be opened before it can be found.
open_settings() {
    on_screen "Settings" || tap_on "More" exact
    tap_on "Settings"
    wait_for "Theme" >/dev/null || sleep 2
}

# Whether a settings switch is on. The row carries the checked state but
# no text of its own, so this finds the label and then the switch row
# wrapped around it: prints "on" or "off", or nothing if there is no such
# row on screen.
#
#   switch_state <label>
switch_state() {
    python3 - "$work/ui.xml" "$1" <<'PY'
import re, sys, xml.etree.ElementTree as ET

path, needle = sys.argv[1], sys.argv[2].lower()

def box(node):
    m = re.match(r"\[(\d+),(\d+)\]\[(\d+),(\d+)\]", node.get("bounds", ""))
    return tuple(int(g) for g in m.groups()) if m else None

try:
    nodes = list(ET.parse(path).getroot().iter("node"))
except ET.ParseError:
    sys.exit(1)

label = next(
    (n for n in nodes if (n.get("text") or "").strip().lower().startswith(needle)),
    None,
)
if label is None or (lb := box(label)) is None:
    sys.exit(1)

# The smallest checkable box that contains the label is its own row and
# not, say, a scroll container that happens to enclose several.
rows = [
    (b, n) for n in nodes if n.get("checkable") == "true"
    if (b := box(n)) and b[0] <= lb[0] and b[1] <= lb[1] and b[2] >= lb[2] and b[3] >= lb[3]
]
if not rows:
    sys.exit(1)
_, row = min(rows, key=lambda r: (r[0][2] - r[0][0]) * (r[0][3] - r[0][1]))
print("on" if row.get("checked") == "true" else "off")
PY
}

# Put a settings switch in a known position. Tapping blind would toggle
# whatever the last run left behind, which is how a screenshot set ends
# up half in one palette and half in another.
#
#   set_switch <label> <on|off>
set_switch() {
    local label=$1 want=$2 now
    wait_for "$label" 15 >/dev/null || die "no \"$label\" switch on screen"
    now=$(switch_state "$label") || die "could not read the \"$label\" switch"
    if [[ $now == "$want" ]]; then
        note "$label already $want"
        return 0
    fi
    tap_on "$label"
    sleep 2
    dump_ui
    [[ $(switch_state "$label") == "$want" ]] ||
        die "could not turn \"$label\" $want"
    note "$label turned $want"
}

# Tap something on the shelf, scrolling down to it if it is below the
# fold. Only the shelf scrolls this way; a swipe in the reader turns a
# page instead.
tap_on_shelf() {
    local needle=$1 i at
    for i in 1 2 3 4 5 6; do
        if dump_ui && at=$(find_node "$needle"); then
            # shellcheck disable=SC2086
            adb shell input tap $at
            sleep 2
            return 0
        fi
        adb shell input swipe "$(x 0.5)" "$(y 0.75)" "$(x 0.5)" "$(y 0.3)" 400
        sleep 2
    done
    die "never found \"$needle\" on the shelf"
}

# Back to the top of the shelf, so a capture starts where the last one did.
shelf_to_top() {
    local i
    for i in 1 2 3 4 5 6; do
        adb shell input swipe "$(x 0.5)" "$(y 0.3)" "$(x 0.5)" "$(y 0.8)" 300
        sleep 1
    done
    sleep 1
}

# The selection popup is a Compose popup, in a window uiautomator does not
# report, so nothing in it can be found by what it says. Its four
# highlight colours give it away in a screenshot instead, and the rest of
# the row sits a fixed distance from the first of them.
readonly TINTS="FFD54F,9CCC65,64B5F6,F06292"
readonly POPUP_NOTE_DP=155
readonly POPUP_DEFINE_DP=216

density=$(adb shell wm density | sed -nE 's/.*density: ([0-9]+).*/\1/p' | tail -n 1)
[[ -n "$density" ]] || density=420
dp() { printf '%.0f' "$(awk "BEGIN { print $1 * $density / 160 }")"; }

# ------------------------------------------------------- where they land
#
# Two sets, because a tablet capture is not a phone capture: fastlane
# and F-Droid publish phoneScreenshots and tenInchScreenshots as separate
# listings, and the README embeds the phone set by name. Writing both to
# one directory means a run against a tablet silently replaces the images
# the README shows.
#
# The phone set is the full tour. The tablet set is three pictures of
# what a phone cannot show -- two columns, the control that chooses them,
# and a shelf with room on it. A tablet listing does not need its own
# picture of the settings screen.
#
# The class is guessed from the width so that no flag is needed to stay
# out of trouble; --class overrides it, for a device whose shape does not
# match how its pictures should be filed.

width_dp=$(awk "BEGIN { printf \"%d\", $width * 160 / $density }")

if [[ -z "$shot_class" ]]; then
    if [[ $width_dp -ge 600 ]]; then
        shot_class="tablet"
    else
        shot_class="phone"
    fi
    note "device is ${width_dp}dp wide: capturing the $shot_class set"
else
    case $shot_class in
        phone | tablet) ;;
        *) die "unknown --class \"$shot_class\": want phone or tablet" ;;
    esac
    note "capturing the $shot_class set (device is ${width_dp}dp wide)"
fi
readonly shot_class

if [[ $shot_class == phone ]]; then
    readonly OUT_DIR="docs/screenshots"
    # F-Droid's directory names are fixed, so the tablet set goes in the
    # one it reads even though nothing here is measured in inches.
    readonly FASTLANE_DIR="fastlane/metadata/android/en-US/images/phoneScreenshots"
else
    readonly OUT_DIR="docs/screenshots/tablet"
    readonly FASTLANE_DIR="fastlane/metadata/android/en-US/images/tenInchScreenshots"
fi

# A screencap decoded to pixels without a library: an emulator host may
# have no Pillow on it, and asking for one would put a pip install
# between a checkout and a screenshot. Reads the file named by the first
# argument and leaves out, width, height, channels and stride behind for
# whatever is appended to it.
readonly PNG_DECODER=$(
    cat <<'PYEOF'
import struct, sys, zlib

path = sys.argv[1]
data = open(path, "rb").read()
if data[:8] != b"\x89PNG\r\n\x1a\n":
    sys.exit(1)

pos, idat, width, height, colour = 8, b"", 0, 0, 0
while pos < len(data):
    length, typ = struct.unpack(">I4s", data[pos:pos + 8])
    chunk = data[pos + 8:pos + 8 + length]
    if typ == b"IHDR":
        width, height, _, colour = struct.unpack(">IIBB", chunk[:10])
    elif typ == b"IDAT":
        idat += chunk
    pos += 12 + length

raw = zlib.decompress(idat)
channels = {0: 1, 2: 3, 3: 1, 4: 2, 6: 4}[colour]
stride = width * channels
out, prev, p = bytearray(), bytearray(stride), 0
for _ in range(height):
    f = raw[p]
    p += 1
    line = bytearray(raw[p:p + stride])
    p += stride
    if f == 1:
        for i in range(channels, stride):
            line[i] = (line[i] + line[i - channels]) & 255
    elif f == 2:
        for i in range(stride):
            line[i] = (line[i] + prev[i]) & 255
    elif f == 3:
        for i in range(stride):
            a = line[i - channels] if i >= channels else 0
            line[i] = (line[i] + ((a + prev[i]) >> 1)) & 255
    elif f == 4:
        for i in range(stride):
            a = line[i - channels] if i >= channels else 0
            b = prev[i]
            c = prev[i - channels] if i >= channels else 0
            pa, pb, pc = abs(b - c), abs(a - c), abs(a + b - 2 * c)
            line[i] = (line[i] + (a if pa <= pb and pa <= pc else (b if pb <= pc else c))) & 255
    out += line
    prev = line
PYEOF
)

# Where the first highlight colour is, as "x y", or nothing if the popup
# is not up. All four colours have to be there, side by side on one row:
# a yellow highlight already on the page is otherwise indistinguishable
# from the yellow chip, and mistaking one for the other means tapping the
# page when the script believes it is tapping a button.
find_popup() {
    adb exec-out screencap -p > "$work/screen.png" 2>/dev/null || return 1
    python3 -c "$PNG_DECODER
$(
        cat <<'PYEOF'
targets = [tuple(int(c[i:i + 2], 16) for i in (0, 2, 4)) for c in sys.argv[2].split(",")]
found = []
for target in targets:
    xs, ys = [], []
    for y in range(0, height, 3):
        row = y * stride
        for x in range(0, width, 3):
            i = row + x * channels
            if all(abs(out[i + n] - target[n]) < 12 for n in range(3)):
                xs.append(x)
                ys.append(y)
    # A stray pixel of the right colour is not a chip; a chip is a disc.
    if len(xs) < 100:
        sys.exit(1)
    found.append((sum(xs) // len(xs), sum(ys) // len(ys)))

# Four discs of different colours, all on one line: that is the popup and
# nothing else on a page of text looks like it.
rows = [y for _, y in found]
if max(rows) - min(rows) > 12:
    sys.exit(1)
print(min(x for x, _ in found), sum(rows) // len(rows))
PYEOF
    )" "$work/screen.png" "$TINTS"
}

# How much of the lower half of the page is ink, in tenths of a percent.
# The page a book was left on can be the last one of a chapter, which is
# a fine place to be reading and a poor thing to publish a picture of:
# three lines at the top and white below them say nothing about how the
# app uses a wide screen.
page_ink() {
    adb exec-out screencap -p > "$work/screen.png" 2>/dev/null || return 1
    python3 -c "$PNG_DECODER
$(
        cat <<'PYEOF'
dark = seen = 0
for y in range(height // 2, height, 4):
    row = y * stride
    for x in range(0, width, 4):
        i = row + x * channels
        seen += 1
        if sum(out[i:i + 3]) / 3 < 160:
            dark += 1
print(int(1000 * dark / seen))
PYEOF
    )" "$work/screen.png"
}

# Turn pages until one of them is worth photographing.
page_to_a_full_page() {
    local i ink
    for i in 1 2 3 4 5 6; do
        ink=$(page_ink || echo 0)
        note "the page is ${ink}/1000 ink"
        [[ $ink -ge 20 ]] && return 0
        turn_pages 1
    done
    die "no page with enough text on it after six turns"
}

x() { printf '%.0f' "$(awk "BEGIN { print $width * $1 }")"; }
y() { printf '%.0f' "$(awk "BEGIN { print $height * $1 }")"; }
tap() { adb shell input tap "$(x "$1")" "$(y "$2")"; }

# Put a sheet away and make sure it went. A sheet that has been dragged
# up to its full height can eat the first back press on the way to
# settling, and the next step then taps into a sheet it thinks is gone.
#
#   dismiss_sheet <something the sheet says>
dismiss_sheet() {
    local needle=$1 i
    for i in 1 2 3; do
        back
        sleep 2
        on_screen "$needle" || return 0
    done
    die "\"$needle\" would not go away"
}

# A long press: a swipe that barely moves, held long enough for the page
# to treat it as a word being picked rather than a tap.
hold() {
    local px py
    px=$(x "$1")
    py=$(y "$2")
    adb shell input swipe "$px" "$py" "$((px + 2))" "$((py + 2))" 1500
    sleep 3
}

# Press a word until the selection popup appears, trying a few places
# down the page: a press that lands in a margin selects nothing. An x
# across the column can be given to land on a different word.
select_a_word() {
    local across=${1:-0.45}
    local spot
    for spot in 0.45 0.55 0.35 0.65; do
        reader_chrome_down
        hold "$across" "$spot"
        if find_popup >/dev/null; then
            return 0
        fi
    done
    return 1
}

# Press and drag along a line to take in a run of words. The notebook is
# what these marks are for, and a list of single words -- "over", "to" --
# says nothing about the book; a phrase reads like something a person
# would have marked on purpose.
#
# The press has to register before the finger moves, so this cannot be a
# swipe: hold the finger down, wait out the long press, and only then
# drag. The gesture runs in one shell so the wait is the device's own.
select_a_phrase() {
    local spot py
    local -a xs ys
    for spot in 0.45 0.55 0.35 0.65; do
        reader_chrome_down
        py=$(y "$spot")
        # A wide screen lays the page out in two columns, and a drag
        # across the whole width crosses the gutter: what comes back is
        # the tail of one column, which reads like nothing anyone meant
        # to mark. Stay inside the left column there, and go down a
        # couple of lines to make up the length the narrower measure
        # costs. A phone has the whole width to itself and keeps it.
        if [[ $shot_class == phone ]]; then
            xs=(0.18 0.32 0.46 0.60 0.74 0.86)
            ys=("$py" "$py" "$py" "$py" "$py" "$py")
        else
            xs=(0.10 0.20 0.34 0.42 0.16 0.38)
            ys=(
                "$py"
                "$py"
                "$py"
                "$py"
                "$(y "$(awk "BEGIN { print $spot + 0.017 }")")"
                "$(y "$(awk "BEGIN { print $spot + 0.017 }")")"
            )
        fi
        adb shell "input motionevent DOWN $(x "${xs[0]}") ${ys[0]}
            sleep 1
            input motionevent MOVE $(x "${xs[1]}") ${ys[1]}
            input motionevent MOVE $(x "${xs[2]}") ${ys[2]}
            input motionevent MOVE $(x "${xs[3]}") ${ys[3]}
            input motionevent MOVE $(x "${xs[4]}") ${ys[4]}
            input motionevent UP $(x "${xs[5]}") ${ys[5]}" >/dev/null 2>&1
        sleep 3
        if find_popup >/dev/null; then
            return 0
        fi
    done
    return 1
}

# The word the definition card is about. The card puts it above
# everything else, and it is the only text on that screen standing on its
# own: the page behind it is paragraphs, and the sense headings come
# after.
dictionary_word() {
    dump_ui || return 1
    python3 - "$work/ui.xml" <<'PY'
import re
import sys
import xml.etree.ElementTree as ET

for node in ET.parse(sys.argv[1]).iter("node"):
    text = (node.get("text") or "").strip()
    if text and re.fullmatch(r"[A-Za-z'-]+", text):
        print(text)
        break
PY
}

# How many marks the library holds, which is how a seeding step tells
# whether it actually did anything.
annotation_count() {
    adb shell "run-as $APP_ID sqlite3 /data/data/$APP_ID/databases/liseur.db \
        'select count(*) from annotations;'" 2>/dev/null | tr -d '\r'
}

# Let go of a selection. A popup left up from the last mark is the reason
# a second one silently turns into a second tap on the first. A tap on
# the page clears it; Back would leave the book altogether.
dismiss_popup() {
    local i
    for i in 1 2 3; do
        find_popup >/dev/null || return 0
        tap 0.5 0.5
        sleep 2
        reader_chrome_down
    done
}

# Tap something in the selection popup, given where the first colour is.
tap_in_popup() {
    local what=$1 at chip_x chip_y
    at=$(find_popup) || return 1
    chip_x=${at% *}
    chip_y=${at#* }
    case $what in
        highlight) adb shell input tap "$chip_x" "$chip_y" ;;
        note) adb shell input tap "$((chip_x + $(dp $POPUP_NOTE_DP)))" "$chip_y" ;;
        define) adb shell input tap "$((chip_x + $(dp $POPUP_DEFINE_DP)))" "$chip_y" ;;
    esac
    sleep 2
}

shot() {
    local name=$1
    adb exec-out screencap -p > "$OUT_DIR/$name.png"
    note "$OUT_DIR/$name.png"
}

# ------------------------------------------------------------- the app

open_first_book() {
    local title=$1
    tap_on_shelf "$title"
    # The reader takes a while to lay the publication out.
    wait_for "Contents" 40 >/dev/null || sleep 8
    sleep 3
}

# Forward, a page at a time. The chrome has to be down first: with it up,
# a tap on the page edge only puts it away again, and the book stays
# exactly where it was.
turn_pages() {
    local count=$1 direction=${2:-forward} edge=0.85 i
    [[ $direction == back ]] && edge=0.15
    reader_chrome_down
    for ((i = 0; i < count; i++)); do
        tap "$edge" 0.5
        sleep 1
    done
    sleep 2
}

# The chrome comes and goes with a tap in the middle of the page.
show_chrome() {
    tap 0.5 0.5
    sleep 2
}

reader_chrome_up() {
    on_screen "Contents" || show_chrome
}

reader_chrome_down() {
    if on_screen "Contents"; then
        show_chrome
    fi
}

# Pick a reading theme by name in the typography sheet, rather than
# trusting whatever the device was left on: that is what stopped the
# light set from quietly coming out dark on a rerun.
choose_reading_theme() {
    local theme=$1
    # Opening the sheet is not always instant, and a dump taken while the
    # reader is still settling can come back without it. Rather than tap
    # where the swatch is meant to be, put the sheet away and open it
    # again.
    for _ in 1 2 3; do
        reader_chrome_up
        if tap_if_there "Aa" exact && wait_for "$theme" 15 exact >/dev/null; then
            tap_on "$theme" exact
            sleep 2
            back
            sleep 2
            return 0
        fi
        back
        sleep 3
    done
    die "could not pick the $theme reading theme"
}

# --------------------------------------------------------------- setup

# The reader screens are captured from the first book, so it has to look
# like a book someone has been reading: a few pages in, with marks on the
# page it reopens on and a notebook worth showing.
seed_reading() {
    local marks
    marks=$(adb shell "run-as $APP_ID sqlite3 /data/data/$APP_ID/databases/liseur.db \
        'select count(*) from annotations;'" 2>/dev/null | tr -d '\r')
    if [[ ${marks:-0} -gt 0 ]]; then
        note "the shelf already carries marks; leaving them alone"
        return 0
    fi

    open_library
    open_first_book "Moby Dick"

    # Jump to the first chapter. Paging in from the front lands in the
    # epigraphs, which are a wall of quotations and attributions and make
    # a poor picture of what reading the app is like. How many pages that
    # takes depends on the type size, so go by the chapter rather than by
    # counting taps.
    reader_chrome_up
    tap_on "Contents"
    tap_on "$FIRST_CHAPTER"
    sleep 4
    reader_chrome_down

    # A few pages in, so the page opens on prose rather than a heading.
    turn_pages 3

    # A mark on each of three pages, so the notebook has something to
    # list. Each is checked against the database, because a highlight
    # that quietly failed looks exactly like one that worked.
    local before after
    for _ in 1 2 3; do
        dismiss_popup
        before=$(annotation_count)
        if select_a_phrase; then
            tap_in_popup highlight
            sleep 2
            after=$(annotation_count)
            if [[ ${after:-0} -gt ${before:-0} ]]; then
                note "highlighted a passage"
            else
                note "the highlight did not take"
            fi
        fi
        dismiss_popup
        # Well clear of the mark just made: a selection that overlaps one
        # edits it instead of adding another, and the count never moves.
        turn_pages 2
    done

    # A note, on a page of its own.
    dismiss_popup
    turn_pages 2
    before=$(annotation_count)
    if select_a_phrase; then
        tap_in_popup note
        if wait_for "What did this make you think" 10 >/dev/null; then
            # Save stays greyed out until the note has words in it, and
            # typing only reaches the field once it holds the cursor.
            tap_on "What did this make you think"
            sleep 1
            adb shell input text "${HIGHLIGHT_NOTE// /%s}"
            sleep 1
            tap_on "Save" exact
            sleep 3
            after=$(annotation_count)
            if [[ ${after:-0} -gt ${before:-0} ]]; then
                note "left a note"
            else
                note "the note did not take"
            fi
        fi
    fi

    dismiss_popup
    reader_chrome_up
    tap_if_there "Bookmark this page" && note "bookmarked the page"
    reader_chrome_down

    # Back to a page carrying a highlight, because that is the page the
    # reader screenshots open on.
    turn_pages 4 back
}

# ------------------------------------------------------------- capture

mkdir -p "$OUT_DIR" "$FASTLANE_DIR"

printf 'Capturing from %s (%sx%s)\n' "$serial" "$width" "$height"

# A demo run should look like a considered library, not a debug session:
# a round clock, no notification icons, a full battery.
adb shell settings put global sysui_demo_allowed 1
adb shell am broadcast -a com.android.systemui.demo -e command enter >/dev/null
adb shell am broadcast -a com.android.systemui.demo -e command clock -e hhmm 1000 >/dev/null
adb shell am broadcast -a com.android.systemui.demo -e command notifications -e visible false >/dev/null
adb shell am broadcast -a com.android.systemui.demo -e command network \
    -e wifi show -e level 4 -e mobile hide >/dev/null
adb shell am broadcast -a com.android.systemui.demo -e command battery \
    -e level 100 -e plugged false >/dev/null

# A device that thinks it has a stylus offers to teach you handwriting
# the first time a text field is touched, and that dialog takes the
# typing meant for the field. Tablet images have one; phones mostly do
# not, which is why this only ever showed up on the big screens.
adb shell settings put secure stylus_handwriting_enabled 0 >/dev/null 2>&1 || true

if ((setup)); then
    step "Fetching the demo shelf"
    fetch_books
    push_books
    step "Granting the folder"
    grant_folder
    step "Making the first book look read"
    seed_reading
fi

if ((setup_only)); then
    printf '\nShelf ready. Run again without --setup to capture.\n'
    exit 0
fi

step "Light"

# Screenshots show Liseur's own palette, not the emulator's wallpaper.
# Wallpaper colours are the default on Android 12 and up, which would
# otherwise make every capture depend on whatever image the emulator
# happens to be showing -- and would tell a store visitor nothing about
# what the app looks like.
open_library
open_settings
set_switch "Colours from your wallpaper" off
back

if [[ $shot_class == tablet ]]; then
    step "The tablet set"
    # Three pictures, not a second copy of the phone tour. A store
    # visitor on a tablet already knows what a settings screen looks
    # like; what they cannot tell from the phone set is whether the app
    # uses the width they paid for.
    open_library
    shelf_to_top
    shot 03-library

    open_first_book "Moby Dick"
    choose_reading_theme "Light"
    reader_chrome_down
    page_to_a_full_page
    shot 01-two-columns

    reader_chrome_up
    tap_on "Aa" exact
    wait_for "Theme" >/dev/null || sleep 2
    # The Columns control only exists on a wide screen, and it sits below
    # the fold, so scroll it into frame. Swiping up scrolls the sheet's
    # content; it is swiping down at the top that would dismiss it.
    adb shell input swipe "$(x 0.5)" "$(y 0.92)" "$(x 0.5)" "$(y 0.72)" 400
    sleep 2
    on_screen "Columns" || die "the Columns control never came into frame"
    shot 02-columns-control
    dismiss_sheet "Line spacing"

    step "The F-Droid set"
    i=1
    for name in 01-two-columns 02-columns-control 03-library; do
        cp "$OUT_DIR/$name.png" "$FASTLANE_DIR/$i.png"
        note "$FASTLANE_DIR/$i.png"
        i=$((i + 1))
    done

    printf '\nDone. Look at the images before committing: a screen can be found\n'
    printf 'and still be showing the wrong thing.\n'
    exit 0
fi

open_library
shelf_to_top
shot 01-library

open_first_book "Moby Dick"
choose_reading_theme "Light"
reader_chrome_down
shot 02-reading

reader_chrome_up
shot 03-chrome

tap_on "Aa" exact
wait_for "Theme" >/dev/null || sleep 2
shot 04-typography
dismiss_sheet "Line spacing"

reader_chrome_up
tap_on "Contents"
shot 05-contents

tap_on "Highlights"
sleep 2
shot 06-highlights
back
sleep 2

step "In-book search"
# The search field has to have taken focus before the text is sent, and
# it does not always get there first: a tablet image offers to teach you
# stylus handwriting the first time a text field is touched, and that
# dialog takes the typing meant for the field. Typing into nothing then
# photographs an empty search screen and calls it a result. So type, look
# at what came back, and start the whole thing over if it was nothing.
searched=0
for attempt in 1 2 3; do
    reader_chrome_up
    tap_on "Search in book"
    sleep 2
    adb shell input text "$SEARCH_TERM"
    sleep 1
    adb shell input keyevent KEYCODE_ENTER
    # A long book takes a moment; a short wait would call it empty.
    wait_for "result" 20 contains >/dev/null && searched=1 && break
    note "the search box did not take the word; starting over"
    # Back out of whatever is on top until the reader is showing again.
    for i in 1 2 3 4; do
        on_screen "Search in this book" || break
        back
        sleep 1
    done
done
[[ $searched -eq 1 ]] || die "the search never returned anything for \"$SEARCH_TERM\""
# Drop the keyboard so the results, not the letters, fill the screen.
back
sleep 2
shot 07-search
back
sleep 3

step "A definition"
# "the" is a word with an entry, so the screen would be found and would
# still be worth nothing to look at. Press elsewhere until the card is
# about a word someone might actually look up. Where a press lands on a
# word worth reading about is luck, and there is more of it to be had on
# a page laid out in two columns, so there are plenty of places to try.
defined=0
for across in 0.60 0.35 0.72 0.50 0.28 0.66 0.42 0.78 0.55 0.31; do
    select_a_word "$across" || continue
    tap_in_popup define
    sleep 7
    looked_up=$(dictionary_word)
    note "the card came back with \"${looked_up:-nothing}\""
    if [[ ${#looked_up} -ge 6 ]]; then
        note "looked up \"$looked_up\""
        shot 12-dictionary
        defined=1
        back
        sleep 2
        break
    fi
    back
    sleep 2
done
((defined)) || note "no word worth defining; keeping the old 12-dictionary.png"

step "Series"

# The Series view only exists once the shelf holds a series, which the
# demo books provide. Failing here is right: a run that quietly captured
# the plain shelf twice would publish a picture of a feature that is not
# in it.
open_library
shelf_to_top
# The filter button carries a summary of what is in force rather than a
# fixed word, so the way in is whatever it reads now: with nothing
# ticked, that is the bare "Filter". The menu stays open under a tap --
# boxes are meant to be ticked several at a time -- so Back is what
# closes it.
tap_on "Filter"
sleep 1
tap_on "Group by series"
sleep 1
back
sleep 3
on_screen "Sherlock Holmes" || die "the Series view never showed a series"
shot 13-series

# Into one series: the volumes in order, where you are in it, and the
# ones missing in between.
tap_on_shelf "Sherlock Holmes"
sleep 3
on_screen "The Hound of the Baskervilles" ||
    die "the series screen never opened"
shot 14-series-detail
back
sleep 2
# Back to the whole shelf, so the screens after this start where the
# earlier ones did. The filters are written down now and survive a
# restart, so leaving this on would quietly put every later shelf into
# series view. The summary reads "Group by series" at this point, which
# is both the way back into the menu and the only thing on screen saying
# so; Clear inside it puts the shelf back and closes the menu itself.
tap_on "Group by series"
sleep 1
tap_on "Clear filters"
sleep 2

step "Settings"
open_library
open_settings
shot 08-settings

tap_on "Book server"
sleep 3
shot 09-server

step "Dark"

adb shell cmd uimode night yes >/dev/null
sleep 3

open_library
shelf_to_top
shot 10-library-dark

open_first_book "Moby Dick"
choose_reading_theme "Dark"
reader_chrome_down
sleep 2
shot 11-reading-dark

# Put the reading theme back, so a rerun starts where this one did.
choose_reading_theme "Light"
reader_chrome_down

step "The F-Droid set"
i=1
for name in 01-library 02-reading 13-series 04-typography 11-reading-dark 06-highlights; do
    cp "$OUT_DIR/$name.png" "$FASTLANE_DIR/$i.png"
    note "$FASTLANE_DIR/$i.png"
    i=$((i + 1))
done

printf '\nDone. Look at the images before committing: a screen can be found\n'
printf 'and still be showing the wrong thing.\n'
