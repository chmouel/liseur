#!/usr/bin/env python3
"""Tests for hack/ai-stub: starts it on a free port and checks every endpoint."""

from __future__ import annotations

import http.client
import json
import re
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

SCRIPT = Path(__file__).resolve().parent / "ai-stub"
failures = 0


def check(name: str, ok: bool, detail: object = "") -> None:
    global failures
    print(f"{'PASS' if ok else 'FAIL'} {name}" + (f": {detail}" if not ok and detail != "" else ""))
    failures += not ok


class Stub:
    def __init__(self, *flags: str, quiet: bool = True):
        self.dir = tempfile.TemporaryDirectory()
        self.log = Path(self.dir.name) / "requests.jsonl"
        self.proc = subprocess.Popen(
            [sys.executable, str(SCRIPT), "--host", "127.0.0.1", "--port", "0", "--log", str(self.log), *(["--quiet"] if quiet else []), *flags],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
        line = self.proc.stdout.readline()
        port = re.search(r":(\d+)/v1", line)
        if not port:
            self.stop()
            raise SystemExit(f"ai-stub did not start: {line!r}")
        self.base = f"http://127.0.0.1:{port.group(1)}"

    def call(self, method: str, path: str, body: object = None, key: str | None = None, header: str = "Authorization"):
        data = body if isinstance(body, bytes) else json.dumps(body).encode() if body is not None else None
        request = urllib.request.Request(self.base + path, data=data, method=method)
        request.add_header("Content-Type", "application/json")
        if key:
            request.add_header(header, key if header != "Authorization" else f"Bearer {key}")
        try:
            with urllib.request.urlopen(request, timeout=10) as reply:
                return reply.status, reply.headers.get("Content-Type"), reply.read()
        except urllib.error.HTTPError as error:
            return error.code, error.headers.get("Content-Type"), error.read()
        except (OSError, http.client.HTTPException) as error:
            return 0, None, str(error).encode()

    def json(self, method: str, path: str, body: dict | None = None, key: str | None = None):
        code, _, data = self.call(method, path, body, key)
        return code, json.loads(data)

    def stop(self) -> None:
        self.proc.terminate()
        self.proc.wait(timeout=5)
        self.proc.stdout.close()
        self.stderr = self.proc.stderr.read()
        self.proc.stderr.close()
        self.dir.cleanup()


def chat(passage: str, book: str | None = None, context: str | None = None) -> dict:
    user = ""
    if book:
        user += f"<book>\n{book}\n</book>\n"
    if context:
        user += f"<context>\n{context}\n</context>\n"
    user += f"<passage>\n{passage}\n</passage>"
    return {"model": "stub-chat", "stream": False, "messages": [
        {"role": "system", "content": "Translate."},
        {"role": "user", "content": user},
    ]}


def main() -> int:
    stub = Stub()
    try:
        code, models = stub.json("GET", "/v1/models")
        ids = [m["id"] for m in models.get("data", [])]
        check("models lists the chat and speech models", code == 200 and ids == ["stub-chat", "stub-tts"], models)

        code, reply = stub.json("POST", "/v1/chat/completions", chat("Il pleut.", book="Book: Dune", context="Il fait gris."))
        text = reply.get("choices", [{}])[0].get("message", {}).get("content")
        check("chat answers with the passage, prefixed", code == 200 and text == "[T] Il pleut.", reply)

        code, reply = stub.json("POST", "/v1/chat/completions", {"messages": [{"role": "user", "content": "Hello"}]})
        check("chat without markers echoes the user message", reply["choices"][0]["message"]["content"] == "[T] Hello", reply)

        code, voices = stub.json("GET", "/v1/audio/voices")
        check("voices lists ungrouped and multilingual stub voices", code == 200 and voices == {"voices": ["stub_a", "stub_b", "af_bella", "ff_siwis", "ef_dora"]}, voices)

        code, kind, audio = stub.call("POST", "/v1/audio/speech", {"model": "stub-tts", "input": "Hello there.", "voice": "stub_a", "response_format": "wav"})
        rate = int.from_bytes(audio[24:28], "little") if len(audio) > 28 else None
        check("speech answers a 24 kHz WAV", code == 200 and kind == "audio/wav" and audio[:4] == b"RIFF" and rate == 24_000, (code, kind, rate))

        code, error = stub.json("POST", "/v1/audio/speech", {"input": "Hi", "response_format": "mp3"})
        check("speech refuses another format, naming response_format", code == 400 and "response_format" in error["error"]["message"], error)

        code, voices = stub.json("GET", "/api/voices/?include_catalog=true&skip=0&limit=100")
        check("gradium voices list uids, names and languages", code == 200 and [v["uid"] for v in voices] == ["stubEmma0001", "stubLouis0002"] and voices[0]["language"] == "en", voices)

        code, kind, audio = stub.call("POST", "/api/post/speech/tts", {"text": "Hello there.", "voice_id": "stubEmma0001", "output_format": "wav", "only_audio": True})
        rate = int.from_bytes(audio[24:28], "little") if len(audio) > 28 else None
        check("gradium speech answers a 48 kHz WAV", code == 200 and kind == "audio/wav" and audio[:4] == b"RIFF" and rate == 48_000, (code, kind, rate))

        code, kind, text = stub.call("POST", "/api/post/speech/tts", {"text": "Hi", "voice_id": "nope", "output_format": "wav", "only_audio": True})
        check("gradium refuses an unknown voice in plain text", code == 500 and kind == "text/plain" and b"voice" in text, (code, kind, text))

        code, entries = stub.json("GET", "/_stub/requests")
        first_chat = next((e for e in entries if e["path"] == "/v1/chat/completions"), {})
        check("the log keeps every request", code == 200 and len(entries) == 9, len(entries))
        check(
            "the log splits the prompt's blocks",
            first_chat.get("blocks") == {"book": "Book: Dune", "context": "Il fait gris.", "passage": "Il pleut."},
            first_chat.get("blocks"),
        )
        check("the log file matches the endpoint", len(stub.log.read_text().splitlines()) == 9)

        stub.json("DELETE", "/_stub/requests")
        code, entries = stub.json("GET", "/_stub/requests")
        check("clearing empties the log", entries == [], entries)
    finally:
        stub.stop()

    stub = Stub(quiet=False)
    try:
        code, _, _ = stub.call("POST", "/v1/audio/speech", b"{not json")
        check("a body that is not JSON gets a 400", code == 400, code)
        code, _, _ = stub.call("POST", "/v1/audio/speech", [1, 2])
        check("a JSON body that is not an object gets a 400", code == 400, code)
        code, _, _ = stub.call("POST", "/v1/audio/speech", {"input": "Still up", "response_format": "wav"})
        check("the stub keeps answering after a bad body", code == 200, code)
    finally:
        stub.stop()
    check("a bad body raises nothing while printing requests", "Traceback" not in stub.stderr, stub.stderr[-300:])

    stub = Stub("--key", "secret", "--think")
    try:
        code, _ = stub.json("GET", "/v1/models")
        check("a required key refuses a request without it", code == 401)
        code, reply = stub.json("POST", "/v1/chat/completions", chat("Oui."), key="secret")
        text = reply["choices"][0]["message"]["content"]
        check("--think puts reasoning before the translation", code == 200 and text.startswith("<think>") and text.endswith("[T] Oui."), text)
        entries = stub.json("GET", "/_stub/requests")[1]
        check("the key is never logged", "secret" not in json.dumps(entries) and entries[-1]["key_sent"] is True)
        code, kind, text = stub.call("GET", "/api/voices/")
        check("gradium refuses a missing key with its 1008 text", code == 500 and kind == "text/plain" and text.startswith(b"error from server 1008"), (code, text))
        code, _, _ = stub.call("GET", "/api/voices/", key="secret", header="x-api-key")
        check("gradium takes the key from x-api-key", code == 200, code)
        entries = stub.json("GET", "/_stub/requests")[1]
        check("the gradium key is never logged either", "secret" not in json.dumps(entries) and entries[-1]["key_sent"] is True)
    finally:
        stub.stop()

    stub = Stub("--fail", "429", "--delay", "0.2")
    try:
        started = time.monotonic()
        code, error = stub.json("POST", "/v1/chat/completions", chat("Non."))
        check("--fail answers chat with that status", code == 429 and error["error"]["code"] == 429, (code, error))
        check("--delay waits before answering", time.monotonic() - started >= 0.2)
        code, _, _ = stub.call("POST", "/v1/audio/speech", {"input": "Hi", "response_format": "wav"})
        check("--fail answers speech with that status", code == 429)
        code, _ = stub.json("GET", "/v1/models")
        check("--fail leaves the model list working", code == 200)
    finally:
        stub.stop()

    print("all passed" if failures == 0 else f"{failures} failed")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
