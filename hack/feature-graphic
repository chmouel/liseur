#!/usr/bin/env python3
"""Render the store feature graphic from the brand emblem.

F-Droid and Play both want a 1024x500 image above the screenshots, and both
crop and scale it freely, so this keeps the title well inside the frame and
lets the mark sit large below it. The artwork is the app's own emblem, so
the listing and the launcher icon can never drift apart.

Needs Pillow.

Usage: hack/feature-graphic [OUTPUT]
       (default fastlane/metadata/android/en-US/images/featureGraphic.png)
"""

from __future__ import annotations

import sys
from pathlib import Path

from PIL import Image, ImageDraw, ImageFont

ROOT = Path(__file__).resolve().parent.parent
EMBLEM = ROOT / "app/src/main/res/drawable-xxxhdpi/ic_brand_emblem.webp"
FONTS = ROOT / "app/src/main/assets/fonts"
OUT = Path(sys.argv[1]) if len(sys.argv) > 1 else (
    ROOT / "fastlane/metadata/android/en-US/images/featureGraphic.png"
)

WIDTH, HEIGHT = 1024, 500
ART_HEIGHT = 320
TAGLINE_MAX_WIDTH = 900
TAGLINE_FONT_SIZE = 27
PLATE = "#F0DFCA"  # MarkFieldLight, the plate the app bar draws behind the mark
INK = (24, 52, 83)
SOFT = (98, 82, 66)
TITLE = "Liseur"
TAGLINE = (ROOT / "fastlane/metadata/android/en-US/short_description.txt").read_text().strip()

art = Image.open(EMBLEM).convert("RGBA")
art = art.resize(
    (round(art.width * ART_HEIGHT / art.height), ART_HEIGHT),
    Image.LANCZOS,
)

image = Image.new("RGB", (WIDTH, HEIGHT), PLATE)
image.paste(art, ((WIDTH - art.width) // 2, HEIGHT - art.height), art)
draw = ImageDraw.Draw(image)
draw.text((WIDTH // 2, 62), TITLE, anchor="mm", fill=INK,
          font=ImageFont.truetype(str(FONTS / "Literata.ttf"), 88))
tagline_font = ImageFont.truetype(str(FONTS / "Inter.ttf"), TAGLINE_FONT_SIZE)
if draw.textlength(TAGLINE, font=tagline_font) > TAGLINE_MAX_WIDTH:
    fitted_size = round(TAGLINE_FONT_SIZE * TAGLINE_MAX_WIDTH /
                        draw.textlength(TAGLINE, font=tagline_font))
    tagline_font = ImageFont.truetype(str(FONTS / "Inter.ttf"), fitted_size)
draw.text((WIDTH // 2, 122), TAGLINE, anchor="mm", fill=SOFT,
          font=tagline_font)
image.save(OUT)

print(f"wrote {OUT.relative_to(ROOT)}")
