#!/usr/bin/env bash
# Exercise the actual workflow step against build-tools output formats.

set -euo pipefail

here=$(dirname "$(readlink -f "$0")")
workdir=$(mktemp -d -t liseur-apk-verification.XXXXXX)
trap 'rm -rf "$workdir"' EXIT

awk '
    /^      - name: Verify release APK$/ { step = 1; next }
    step && /^        run: \|$/ { body = 1; next }
    body && /^      - / { exit }
    body { sub(/^          /, ""); print }
' "$here/../.github/workflows/release.yml" > "$workdir/verify.sh"
test -s "$workdir/verify.sh"

mkdir -p "$workdir/sdk/build-tools/37.0.0" "$workdir/runner"
cat > "$workdir/sdk/build-tools/37.0.0/apksigner" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[[ "$1 $2 $3" == 'verify --verbose --print-certs' ]]
test -f "$4"
cat "$MOCK_VERIFICATION"
exit "${MOCK_VERIFY_STATUS:-0}"
EOF
chmod +x "$workdir/sdk/build-tools/37.0.0/apksigner"

export ANDROID_HOME="$workdir/sdk"
export RUNNER_TEMP="$workdir/runner"
export GITHUB_ENV="$workdir/github-env"
export RELEASE_TAG=v0.20.0
export MOCK_VERIFICATION="$workdir/verification.txt"

digest=394e0413024451b8782c492fee203f9470871e63d6e41088e42af3f7c6650a94
other_digest=802fa08765ec04b3b2bb2d2665fb853582ff2d57888a10fa0aa413c87fe9586b

verify_case() {
    local name=$1 expected=$2
    local case_dir="$workdir/$name"
    mkdir -p "$case_dir/app/build/outputs/apk/foss/release"
    touch "$case_dir/app/build/outputs/apk/foss/release/app-foss-release.apk"
    cat > "$MOCK_VERIFICATION"
    : > "$GITHUB_ENV"
    if (cd "$case_dir" && bash "$workdir/verify.sh") > "$workdir/output" 2>&1; then
        [[ "$expected" == pass ]] || {
            printf '%s unexpectedly passed.\n' "$name" >&2
            exit 1
        }
        grep -Fxq "RELEASE_CERTIFICATE_SHA256=$digest" "$GITHUB_ENV"
        grep -Fxq 'RELEASE_APK=app/build/outputs/apk/foss/release/liseur-v0.20.0.apk' "$GITHUB_ENV"
        test -f "$case_dir/app/build/outputs/apk/foss/release/liseur-v0.20.0.apk"
        test ! -f "$case_dir/app/build/outputs/apk/foss/release/app-foss-release.apk"
    else
        [[ "$expected" == fail ]] || {
            cat "$workdir/output" >&2
            printf '%s unexpectedly failed.\n' "$name" >&2
            exit 1
        }
        test ! -s "$GITHUB_ENV"
        test -f "$case_dir/app/build/outputs/apk/foss/release/app-foss-release.apk"
    fi
}

verify_case numbered pass <<EOF
Verifies
Signer #1 certificate SHA-256 digest: $digest
Signer #1 public key SHA-256 digest: $other_digest
EOF

verify_case scheme pass <<EOF
Verifies
V3.0 Signer: certificate SHA-256 digest: $digest
V3.0 Signer: public key SHA-256 digest: $other_digest
EOF

verify_case repeated pass <<EOF
Signer #1 certificate SHA-256 digest: $digest
V3.0 Signer: certificate SHA-256 digest: $digest
V3.1 Signer: certificate SHA-256 digest: $digest
EOF

verify_case missing fail <<EOF
V3.0 Signer: public key SHA-256 digest: $other_digest
EOF

verify_case malformed fail <<EOF
V3.0 Signer: certificate SHA-256 digest: invalid
EOF

verify_case multiple fail <<EOF
Signer #1 certificate SHA-256 digest: $digest
Signer #2 certificate SHA-256 digest: $other_digest
EOF

MOCK_VERIFY_STATUS=1 verify_case invalid-signature fail <<EOF
V3.0 Signer: certificate SHA-256 digest: $digest
EOF

# F-Droid builds whatever flavor the fdroiddata entry names; a bare `yes`
# would run assembleRelease and build the play flavor along with it.
entry=$(awk '/function entry\(\)/,/^        }$/' "$here/release")
grep -Fq 'print "      - foss"' <<<"$entry" || {
    printf 'hack/release must emit gradle: [foss] for the fdroiddata entry.\n' >&2
    exit 1
}
if grep -Eq 'print "      - yes"' <<<"$entry"; then
    printf 'hack/release still emits gradle: [yes].\n' >&2
    exit 1
fi

printf 'Release APK verification tests passed.\n'
