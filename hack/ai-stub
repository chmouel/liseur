#!/usr/bin/env python3
"""A fake OpenAI-compatible server that logs what Liseur sends it.

Covers what translation and read aloud call on a server from the
External services and API keys page:

  GET  /v1/models            stub-chat and stub-tts
  POST /v1/chat/completions  replies with the <passage> it was sent, prefixed;
                             a numbered batch ([1] ..., [2] ...) line by line
  POST /v1/audio/speech      silent 24 kHz mono 16-bit WAV, sized to the text
  GET  /v1/audio/voices      stub_a, stub_b and English/French/Spanish voices

And what read aloud calls on a Gradium server, under its /api root; the
app speaks Gradium's protocol to its real hosts only, so these answer
a client pointed here on purpose (see hack/test-ai-stub):

  GET  /api/voices/          two voices with a name and a language each
  POST /api/post/speech/tts  silent 48 kHz mono 16-bit WAV, sized to the text

Every request is appended to the log as one JSON line. A chat request
also has its user message split into the prompt's blocks (book,
context, passage) so a check can read them without parsing the prompt.
The API key is never logged, only whether one was sent.

  GET    /_stub/requests     the log, as a JSON list
  DELETE /_stub/requests     clears it

An emulator reaches the host at 10.0.2.2: add the server in the app as
http://10.0.2.2:8765/v1. Standard library only.
"""

from __future__ import annotations

import argparse
import json
import re
import struct
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

CHAT_MODEL = "stub-chat"
SPEECH_MODEL = "stub-tts"
VOICES = ["stub_a", "stub_b", "af_bella", "ff_siwis", "ef_dora"]
GRADIUM_VOICES = [
    {"uid": "stubEmma0001", "name": "Emma", "description": "Stub", "is_catalog": True, "is_pro_clone": False, "language": "en", "tags": []},
    {"uid": "stubLouis0002", "name": "Louis", "description": None, "is_catalog": False, "is_pro_clone": False, "language": "fr", "tags": []},
]
SAMPLE_RATE = 24_000
GRADIUM_SAMPLE_RATE = 48_000
# Silence per character of input, so a longer sentence plays longer.
SECONDS_PER_CHARACTER = 0.03
MAX_SECONDS = 20.0
BLOCKS = ("book", "context", "passage")
NUMBERED = re.compile(r"\[(\d+)\] (.*)")

DEFAULT_LOG = Path(__file__).resolve().parent.parent / "tmp/ai-stub/requests.jsonl"


def wav(seconds: float, rate: int = SAMPLE_RATE) -> bytes:
    frames = int(rate * max(0.1, min(seconds, MAX_SECONDS)))
    data = bytes(frames * 2)
    header = b"RIFF" + struct.pack("<I", 36 + len(data)) + b"WAVE"
    fmt = b"fmt " + struct.pack("<IHHIIHH", 16, 1, 1, rate, rate * 2, 2, 16)
    return header + fmt + b"data" + struct.pack("<I", len(data)) + data


def blocks(text: str) -> dict[str, str]:
    """The prompt's <book>, <context> and <passage> blocks, by name."""
    found = {}
    for name in BLOCKS:
        tag = rf"{name}(?:_\d+)?"
        match = re.search(rf"<({tag})>\n?(.*?)\n?</\1>", text, re.DOTALL)
        if match:
            found[name] = match.group(2)
    return found


def user_text(body: dict) -> str:
    users = [m for m in body.get("messages", []) if isinstance(m, dict) and m.get("role") == "user"]
    content = users[-1].get("content", "") if users else ""
    if isinstance(content, list):
        content = "".join(part.get("text", "") for part in content if isinstance(part, dict))
    return content if isinstance(content, str) else ""


class Stub:
    def __init__(self, args: argparse.Namespace):
        self.args = args
        self.log = Path(args.log)
        self.lock = threading.Lock()
        self.speech_failures = args.speech_failures
        self.log.parent.mkdir(parents=True, exist_ok=True)
        if not args.keep_log:
            self.log.write_text("")

    def record(self, entry: dict) -> None:
        with self.lock, self.log.open("a", encoding="utf-8") as out:
            out.write(json.dumps(entry, ensure_ascii=False) + "\n")
        if not self.args.quiet:
            body = entry.get("body")
            shown = entry.get("blocks", {}).get("passage") or (body.get("input") if isinstance(body, dict) else None) or ""
            print(f"{entry['method']} {entry['path']} {shown[:60]!r}" if shown else f"{entry['method']} {entry['path']}", flush=True)

    def entries(self) -> list[dict]:
        with self.lock:
            lines = self.log.read_text(encoding="utf-8").splitlines() if self.log.exists() else []
        return [json.loads(line) for line in lines if line.strip()]

    def clear(self) -> None:
        with self.lock:
            self.log.write_text("")


def handler(stub: Stub):
    args = stub.args

    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, *_):
            pass

        def send(self, code: int, payload, content_type: str = "application/json") -> None:
            data = payload if isinstance(payload, bytes) else json.dumps(payload).encode()
            self.send_response(code)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def error(self, code: int, message: str) -> None:
            self.send(code, {"error": {"message": message, "type": "stub_error", "code": code}})

        def route(self) -> str:
            path = self.path.split("?", 1)[0].rstrip("/")
            return path[len("/v1"):] if path.startswith("/v1/") else path

        def authorized(self) -> bool:
            if args.key is None:
                return True
            if self.headers.get("Authorization") == f"Bearer {args.key}":
                return True
            self.error(401, "Invalid API key")
            return False

        def gradium_authorized(self) -> bool:
            """Gradium reads an x-api-key header, and refuses in plain text with its code 1008."""
            if args.key is None or self.headers.get("x-api-key") == args.key:
                return True
            self.send(500, b"error from server 1008: API key is revoked or expired", "text/plain")
            return False

        def entry(self, body=None) -> dict:
            entry = {
                "time": time.strftime("%Y-%m-%dT%H:%M:%S"),
                "method": self.command,
                "path": self.path,
                "key_sent": "Authorization" in self.headers or "x-api-key" in self.headers,
            }
            if body is not None:
                entry["body"] = body
            return entry

        def do_GET(self):
            route = self.route()
            if route == "/_stub/requests":
                return self.send(200, stub.entries())
            stub.record(self.entry())
            if route == "/api/voices":
                return self.send(200, GRADIUM_VOICES) if self.gradium_authorized() else None
            if not self.authorized():
                return None
            if route == "/models":
                return self.send(200, {"object": "list", "data": [
                    {"id": CHAT_MODEL, "object": "model", "owned_by": "stub"},
                    {"id": SPEECH_MODEL, "object": "model", "owned_by": "stub"},
                ]})
            if route == "/audio/voices":
                return self.send(200, {"voices": VOICES})
            return self.error(404, f"Unknown endpoint {self.path}")

        def do_DELETE(self):
            if self.route() == "/_stub/requests":
                stub.clear()
                return self.send(200, {"cleared": True})
            return self.error(404, f"Unknown endpoint {self.path}")

        def do_POST(self):
            raw = self.rfile.read(int(self.headers.get("Content-Length") or 0))
            try:
                body = json.loads(raw or b"{}")
            except (json.JSONDecodeError, UnicodeDecodeError):
                stub.record(self.entry(raw.decode("utf-8", "replace")))
                return self.error(400, "Body is not JSON")
            if not isinstance(body, dict):
                stub.record(self.entry(body))
                return self.error(400, "Body is not a JSON object")
            entry = self.entry(body)
            route = self.route()
            if route == "/chat/completions":
                entry["blocks"] = blocks(user_text(body))
            elif route == "/audio/speech" and isinstance(body.get("instructions"), str):
                entry["blocks"] = blocks(body["instructions"])
            stub.record(entry)
            if route == "/api/post/speech/tts":
                return self.gradium_speech(body) if self.gradium_authorized() else None
            if not self.authorized():
                return None
            if args.delay:
                time.sleep(args.delay)
            if args.fail and route in ("/chat/completions", "/audio/speech"):
                return self.error(args.fail, f"Stub failing with {args.fail}")
            if route == "/chat/completions":
                return self.chat(body, entry["blocks"])
            if route == "/audio/speech":
                with stub.lock:
                    fail = stub.speech_failures > 0
                    if fail:
                        stub.speech_failures -= 1
                if fail:
                    return self.error(503, "Temporary speech failure")
                return self.speech(body)
            return self.error(404, f"Unknown endpoint {self.path}")

        def chat(self, body: dict, found: dict[str, str]) -> None:
            if args.refuse and args.refuse in found.get("passage", user_text(body)):
                return self.send(200, {
                    "choices": [{"index": 0, "finish_reason": "stop",
                                 "message": {"role": "assistant", "refusal": "Stub refusal"}}],
                })
            passage = found.get("passage", user_text(body))
            lines = passage.split("\n")
            numbered = [NUMBERED.match(line) for line in lines]
            if len(lines) > 1 and all(numbered):
                text = "\n".join(f"[{m.group(1)}] {args.prefix}{m.group(2)}" for m in numbered)
            else:
                text = args.prefix + passage
            if args.think:
                text = "<think>\nThe stub is thinking.\n</think>\n" + text
            self.send(200, {
                "id": "stub",
                "object": "chat.completion",
                "created": int(time.time()),
                "model": body.get("model", CHAT_MODEL),
                "choices": [{"index": 0, "finish_reason": "stop", "message": {"role": "assistant", "content": text}}],
                "usage": {"prompt_tokens": 0, "completion_tokens": 0, "total_tokens": 0},
            })

        def speech(self, body: dict) -> None:
            fmt = body.get("response_format", "mp3")
            if fmt != "wav":
                return self.error(400, f"Unsupported response_format: {fmt}")
            text = body.get("input") or ""
            self.send(200, wav(len(text) * SECONDS_PER_CHARACTER), "audio/wav")

        def gradium_speech(self, body: dict) -> None:
            if args.delay:
                time.sleep(args.delay)
            if args.fail:
                return self.send(args.fail, f"error from server {args.fail}: stub failing".encode(), "text/plain")
            if body.get("output_format") != "wav" or body.get("only_audio") is not True:
                return self.send(500, b"unsupported output", "text/plain")
            if body.get("voice_id") not in {v["uid"] for v in GRADIUM_VOICES}:
                return self.send(500, b"error from server 1003: voice not found", "text/plain")
            text = body.get("text") or ""
            self.send(200, wav(len(text) * SECONDS_PER_CHARACTER, GRADIUM_SAMPLE_RATE), "audio/wav")

    return Handler


def parse(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Fake OpenAI-compatible translation and speech server that logs requests.",
        epilog="In the app, add http://10.0.2.2:PORT/v1 (emulator) under External services and API keys.",
    )
    parser.add_argument(
        "--host",
        default="127.0.0.1",
        help="address to listen on; the emulator's 10.0.2.2 reaches the host's loopback (default: %(default)s)",
    )
    parser.add_argument("--port", type=int, default=8765, help="port, 0 for any free one (default: %(default)s)")
    parser.add_argument("--log", default=str(DEFAULT_LOG), help="JSON-lines request log (default: tmp/ai-stub/requests.jsonl)")
    parser.add_argument("--keep-log", action="store_true", help="append to the log instead of starting it empty")
    parser.add_argument("--prefix", default="[T] ", help="put before every translation (default: %(default)r)")
    parser.add_argument("--delay", type=float, default=0, help="seconds to wait before answering chat and speech")
    parser.add_argument("--speech-failures", type=int, default=0, metavar="COUNT", help="fail the first COUNT speech requests with HTTP 503")
    parser.add_argument("--fail", type=int, metavar="CODE", help="answer chat and speech with this HTTP status")
    parser.add_argument("--refuse", metavar="TEXT", help="refuse chat passages containing this text")
    parser.add_argument("--key", help="require this API key as a bearer token (x-api-key on the Gradium routes), refused otherwise")
    parser.add_argument("--think", action="store_true", help="put a <think> block before every translation")
    parser.add_argument("--quiet", action="store_true", help="do not print a line per request")
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse(argv)
    stub = Stub(args)
    server = ThreadingHTTPServer((args.host, args.port), handler(stub))
    print(f"ai-stub on http://{args.host}:{server.server_address[1]}/v1, log {stub.log}", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
