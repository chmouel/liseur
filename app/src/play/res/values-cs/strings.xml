    <string name="translation_mlkit_download_confirm">Stáhnout</string>
    <string name="translation_mlkit_help">Překladač Google ML Kit pracuje v tomto telefonu, takže se text knihy Googlu neodesílá. ML Kit však posílá Googlu diagnostická data a údaje o používání, například chyby a dobu zpracování.</string>
