    <string name="translation_provider_mlkit">Google v tomto telefonu</string>
    <string name="translation_provider_mlkit_summary">Překladač ML Kit od Googlu funguje v telefonu po stažení jazykových balíčků. Pasáže neopouštějí telefon; ML Kit Googlu odesílá diagnostická data o používání.</string>
