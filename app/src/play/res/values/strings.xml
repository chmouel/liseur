    <string name="hardcover_settings_summary">Report your reading to your Hardcover account</string>
    <string name="reading_services_title">Reading services</string>
    <string name="hardcover_intro">Liseur can tell Hardcover what you are reading, how far along you are, when you started and finished, and sync your ratings and reviews. Your reading status and progress are sent one way; the edition picker shows public catalogue details only.</string>
    <string name="hardcover_intro_evaluations">Ratings and reviews sync both ways. Your review is published as your public Hardcover review.</string>
