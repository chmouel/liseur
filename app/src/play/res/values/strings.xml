    <string name="licences_intro">Liseur is built from free and open-source components, except Google\'s ML Kit translation in this Google Play edition, which Google provides under its own terms.</string>
    <string name="translation_mlkit_acknowledgement">Translations are powered by Google Translate technology, running on this phone through Google\'s ML Kit.</string>
    <string name="translation_mlkit_cloud" translatable="false">Google Cloud Translation</string>
