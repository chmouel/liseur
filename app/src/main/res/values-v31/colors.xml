<resources>
    <!--
        Android 12 and up take the palette from the wallpaper, so the
        splash and the window behind the app follow it too. Without this
        the app flashes a flat white page and then redraws in whatever
        colour the wallpaper asked for.
    -->
    <color name="paper">@android:color/system_neutral1_10</color>
    <color name="ink">@android:color/system_neutral1_900</color>
</resources>
