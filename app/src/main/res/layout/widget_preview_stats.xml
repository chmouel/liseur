<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@drawable/widget_preview_card">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_currently_reading" android:textSize="12sp"
        android:textColor="@color/widget_preview_fill" />
    <FrameLayout android:layout_width="180dp" android:layout_height="18dp"
        android:layout_marginTop="8dp" android:background="@drawable/widget_preview_block"
        android:backgroundTint="@color/widget_preview_ink" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="6dp"
        android:layout_marginTop="12dp" android:background="@drawable/widget_preview_block"
        android:backgroundTint="@color/widget_preview_rule">
        <FrameLayout android:layout_width="90dp" android:layout_height="match_parent"
            android:background="@drawable/widget_preview_block"
            android:backgroundTint="@color/widget_preview_fill" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="24dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/reading_stats_this_week_local" android:textSize="12sp"
                android:textColor="@color/widget_preview_fill" />
            <FrameLayout android:layout_width="64dp" android:layout_height="20dp"
                android:layout_marginTop="8dp" android:background="@drawable/widget_preview_block"
                android:backgroundTint="@color/widget_preview_ink" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/reading_stats_this_month_local" android:textSize="12sp"
                android:textColor="@color/widget_preview_fill" />
            <FrameLayout android:layout_width="64dp" android:layout_height="20dp"
                android:layout_marginTop="8dp" android:background="@drawable/widget_preview_block"
                android:backgroundTint="@color/widget_preview_ink" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/reading_stats_this_year_local" android:textSize="12sp"
                android:textColor="@color/widget_preview_fill" />
            <FrameLayout android:layout_width="76dp" android:layout_height="20dp"
                android:layout_marginTop="8dp" android:background="@drawable/widget_preview_block"
                android:backgroundTint="@color/widget_preview_ink" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
