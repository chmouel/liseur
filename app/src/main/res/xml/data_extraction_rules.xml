<?xml version="1.0" encoding="utf-8"?>
<!--
  Same list as backup_rules.xml, for Android 12 and later.

  The calibre-web password and sync token live in the database and are
  encrypted with a Keystore key that cannot leave the device, so they
  arrive unreadable however they travel. The app notices that on first
  run and asks for the account again rather than pretending to be
  connected.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="liseur.db" />
        <include domain="file" path="datastore" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="liseur.db" />
        <include domain="file" path="datastore" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
