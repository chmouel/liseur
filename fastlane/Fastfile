# Google Play uploads only. Nothing here is part of building Liseur:
# F-Droid and the GitHub release both build the APK with plain Gradle and
# never see this directory.
#
# The metadata under fastlane/metadata/android is written for F-Droid and
# happens to be supply's native layout, so Play reads the same files. The
# release lanes push the changelog and nothing else. The screenshots lane
# pushes the phone and tablet screenshots, which the repository owns: the
# en-US set replaces whatever the console holds in every listing language,
# and the feature_graphic
# lane does the same for the feature graphics. The rest of the listing is
# edited in the console, because Play holds the declarations (data safety,
# content rating, target audience) that no file in this repository
# describes, and an accidental metadata push is a listing change under
# review.
#
# A build goes to two tracks, not one. Internal testing is the fast lane
# and holds a hundred hand-listed addresses at most; the closed track is
# where testers are actually recruited — it is the one the opt-in link in
# issue #62 points at, and the only one whose opted-in testers count
# towards the twelve Play wants for fourteen days before a personal
# account may publish. Uploading to internal alone, which this did until
# 0.10.0, leaves everyone who followed the instructions on whatever build
# the closed track was last given by hand.

default_platform(:android)

# The track the bundle is uploaded to, and the track that upload is then
# promoted to. The second name is the closed track's id in the Play API,
# which is the display name it was created with rather than one of the
# four standard ids.
INTERNAL_TRACK = "internal".freeze
CLOSED_TRACK = "Testing".freeze
PRODUCTION_TRACK = "production".freeze

# The version code being released, read from the one file that decides
# it. Promotion has to name a build, and naming it from the source is
# what keeps the promotion pointed at the bundle just uploaded.
def liseur_version_code
  gradle = File.expand_path("../app/build.gradle.kts", __dir__)
  code = File.read(gradle)[/^\s*versionCode\s*=\s*(\d+)/, 1]
  UI.user_error!("no versionCode in #{gradle}") if code.nil?
  code.to_i
end

# Moving a build already on the internal track across to another track.
# The bundle is not sent again: Play refuses a version code it has seen,
# so the only way to put one build on two tracks is to promote it.
def liseur_promote(version_code, target_track)
  upload_to_play_store(
    track: INTERNAL_TRACK,
    track_promote_to: target_track,
    track_promote_release_status: "completed",
    version_code: version_code,
    # Promoting takes the build off the track it came from unless it is
    # told not to. Internal remains the fast lane for the same artifact.
    deactivate_on_promote: false,
    skip_upload_aab: true,
    skip_upload_apk: true,
    skip_upload_metadata: true,
    skip_upload_images: true,
    skip_upload_screenshots: true,
    skip_upload_changelogs: false,
    validate_only: ENV["PLAY_VALIDATE_ONLY"] == "true"
  )
end

# The languages the Play listing is translated into, read from a
# throwaway edit that is dropped again.
def liseur_listing_languages
  require "supply"
  Supply.config = FastlaneCore::Configuration.create(
    Supply::Options.available_options,
    package_name: CredentialsManager::AppfileConfig.try_fetch_value(:package_name)
  )
  client = Supply::Client.make_from_config
  client.begin_edit(package_name: Supply.config[:package_name])
  begin
    client.listings.map(&:language).sort
  ensure
    client.abort_current_edit
  end
end

platform :android do
  desc "Upload the release bundle to the Play internal track, then promote it to the closed track (promote:false stops at internal)"
  lane :internal do |options|
    # Anchored to this file rather than the working directory: fastlane
    # runs lanes from inside fastlane/, so a bare relative path would
    # look for the bundle one directory too deep and never find it.
    bundle = File.expand_path("../app/build/outputs/bundle/playRelease/app-play-release.aab", __dir__)
    UI.user_error!("no bundle at #{bundle} — run ./gradlew bundlePlayRelease") unless File.exist?(bundle)

    version_code = liseur_version_code

    upload_to_play_store(
      track: INTERNAL_TRACK,
      aab: bundle,
      # A track upload is a release; the APK path belongs to GitHub.
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
      # The first upload of all is done by hand, because enrolling the
      # signing key happens inside the console's release wizard. Every
      # upload after that goes straight to the testers.
      release_status: "completed",
      validate_only: ENV["PLAY_VALIDATE_ONLY"] == "true"
    )

    # Nightlies stay on internal: closed-track testers get candidates and
    # releases only.
    if options[:promote].to_s == "false"
      UI.success("#{version_code} is on #{INTERNAL_TRACK}")
      next
    end

    liseur_promote(version_code, CLOSED_TRACK)
    UI.success("#{version_code} is on #{INTERNAL_TRACK} and #{CLOSED_TRACK}")
  end

  desc "Promote the release on the internal track to production"
  lane :production do |options|
    requested = (options[:version_code] || ENV["PLAY_VERSION_CODE"] || liseur_version_code).to_s
    unless requested.match?(/\A[1-9][0-9]*\z/)
      UI.user_error!("version_code must be a positive integer, got #{requested.inspect}")
    end

    version_code = requested.to_i
    liseur_promote(version_code, PRODUCTION_TRACK)
    UI.success("#{version_code} is published on #{PRODUCTION_TRACK}")
  end

  desc "Replace the Play listing's phone and tablet screenshots in every language with the repository's en-US set"
  lane :screenshots do |options|
    requested = (options[:version_code] || ENV["PLAY_VERSION_CODE"] || liseur_version_code).to_s
    unless requested.match?(/\A[1-9][0-9]*\z/)
      UI.user_error!("version_code must be a positive integer, got #{requested.inspect}")
    end

    # Refuse a set Play would refuse before opening an edit, rather than
    # after half of it has been uploaded.
    metadata = File.expand_path("metadata/android", __dir__)
    images = File.join(metadata, "en-US", "images")
    kinds = %w[phoneScreenshots tenInchScreenshots]
    checker = File.expand_path("../hack/store-images", __dir__)
    unless system(checker, "--check", *kinds.map { |kind| File.join(images, kind) })
      UI.user_error!("the store screenshots would be refused; run hack/store-images on them")
    end

    # Each listing language has its own screenshots on Play, and a
    # language with no screenshots folder is left with whatever it had.
    # The repository keeps one set, so every language Play has a listing
    # in gets a copy of it in a staged tree; F-Droid already falls back to
    # en-US on its own. Play refuses images for a language it has no
    # listing in, so the metadata folders cannot be the list.
    languages = liseur_listing_languages
    Dir.mktmpdir do |staged|
      languages.each do |language|
        kinds.each do |kind|
          target = File.join(staged, language, "images", kind)
          FileUtils.mkdir_p(target)
          FileUtils.cp(Dir[File.join(images, kind, "*.png")], target)
        end
      end

      # A listing edit still has to name a release on some track; internal
      # holds every build. With no track_promote_to and no rollout, supply
      # leaves the tracks exactly as they are.
      upload_to_play_store(
        track: INTERNAL_TRACK,
        version_code: requested.to_i,
        metadata_path: staged,
        skip_upload_aab: true,
        skip_upload_apk: true,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_changelogs: true,
        skip_upload_screenshots: false,
        # Compare checksums in order: an unchanged set is no upload and no
        # deletion, and anything else is replaced to match the repository.
        sync_image_upload: true,
        validate_only: ENV["PLAY_VALIDATE_ONLY"] == "true"
      )
    end
    if ENV["PLAY_VALIDATE_ONLY"] == "true"
      UI.success("Play accepted the screenshot edit for #{languages.join(", ")}; nothing was committed")
    else
      UI.success("the Play listing screenshots match the repository in #{languages.join(", ")}")
    end
  end

  desc "Replace the Play listing's feature graphics with the repository's"
  lane :feature_graphic do |options|
    requested = (options[:version_code] || ENV["PLAY_VERSION_CODE"] || liseur_version_code).to_s
    unless requested.match?(/\A[1-9][0-9]*\z/)
      UI.user_error!("version_code must be a positive integer, got #{requested.inspect}")
    end

    metadata = File.expand_path("metadata/android", __dir__)
    graphics = Dir[File.join(metadata, "*", "images", "featureGraphic.png")]
      .to_h { |path| [File.basename(File.dirname(path, 2)), path] }
    # Play refuses images for a language the listing has no translation
    # in, so languages:en-US,fr-FR limits the push to those.
    languages = options[:languages] ? options[:languages].split(",").map(&:strip) : graphics.keys.sort
    missing = languages - graphics.keys
    UI.user_error!("no feature graphic for #{missing.join(", ")}") unless missing.empty?

    checker = File.expand_path("../hack/store-images", __dir__)
    unless system(checker, "--check", "--feature-graphic", *languages.map { |language| graphics[language] })
      UI.user_error!("a feature graphic would be refused; run make feature-graphic")
    end

    # supply uploads every image type it finds, the icon included, so it
    # reads a copy of the tree holding the feature graphics alone.
    Dir.mktmpdir do |staged|
      languages.each do |language|
        images = File.join(staged, language, "images")
        FileUtils.mkdir_p(images)
        FileUtils.cp(graphics[language], images)
      end
      upload_to_play_store(
        track: INTERNAL_TRACK,
        version_code: requested.to_i,
        metadata_path: staged,
        skip_upload_aab: true,
        skip_upload_apk: true,
        skip_upload_metadata: true,
        skip_upload_images: false,
        skip_upload_changelogs: true,
        skip_upload_screenshots: true,
        sync_image_upload: true,
        validate_only: ENV["PLAY_VALIDATE_ONLY"] == "true"
      )
    end
    if ENV["PLAY_VALIDATE_ONLY"] == "true"
      UI.success("Play accepted the feature graphic edit for #{languages.join(", ")}; nothing was committed")
    else
      UI.success("the Play feature graphics for #{languages.join(", ")} match the repository")
    end
  end

  desc "Promote a build already on the internal track to the closed track, without rebuilding"
  lane :promote do |options|
    # For a release whose bundle is already up: the version code can be
    # named outright (fastlane android promote version_code:19), and
    # falls back to whatever the source says is current.
    requested = (options[:version_code] || ENV["PLAY_VERSION_CODE"] || liseur_version_code).to_s
    # to_i turns anything unparseable into 0, which Play would take as a
    # promotion of nothing at all: refuse it here instead.
    unless requested.match?(/\A[1-9][0-9]*\z/)
      UI.user_error!("version_code must be a positive integer, got #{requested.inspect}")
    end

    version_code = requested.to_i
    liseur_promote(version_code, CLOSED_TRACK)
    UI.success("#{version_code} is on #{CLOSED_TRACK}")
  end
end
